@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix gist: <https://w3id.org/semanticarts/ns/ontology/gist/> .
@prefix gistd: <https://w3id.org/semanticarts/ns/data/gist/> .
@prefix gists: <https://w3id.org/lmodel/gists/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix media_app: <https://www.iana.org/assignments/media-types/application/> .
@prefix media_img: <https://www.iana.org/assignments/media-types/image/> .
@prefix media_txt: <https://www.iana.org/assignments/media-types/text/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/lmodel/gists.owl.ttl> a owl:Ontology ;
    rdfs:label "gists" ;
    dcterms:license "CC-BY-4.0" ;
    dcterms:title "gists" ;
    pav:version "14.1.0" ;
    rdfs:seeAlso <https://lmodel.github.io/gists>,
        <https://w3id.org/semanticarts/ontology/gistCore>,
        <https://www.semanticarts.com/gist/> ;
    skos:definition "gist  is a minimalist upper ontology created by Semantic Arts for enterprise knowledge graph applications. This LinkML schema (version 14.1.0) aggregates the gist modules: Core (classes and properties), MediaTypes (IANA media type instances), and PrefixDeclarations (SHACL namespace bindings). Supplementary schemas gists_rdfs_annotations and gists_sub_class_assertions are available for annotation enrichment and OWL RL reasoner support." .

gists:Account a owl:Class ;
    rdfs:label "Account" ;
    rdfs:subClassOf gists:Agreement ;
    skos:altLabel "Account" ;
    skos:closeMatch <https://w3id.org/lmodel/common_domain_model/Account> ;
    skos:definition "An agreement having a balance." ;
    skos:editorialNote "OWL equivalentClass: (gist:Agreement & ∃hasMagnitude.∃hasAspect=_Aspect_financial_balance)" ;
    skos:exactMatch gist:Account ;
    skos:inScheme gists:core .

gists:AddressUsageType a owl:Class ;
    rdfs:label "AddressUsageType" ;
    rdfs:subClassOf gists:Category ;
    skos:altLabel "Address Usage Type" ;
    skos:definition "A category indicating the context or manner in which an address may be used." ;
    skos:exactMatch gist:AddressUsageType ;
    skos:inScheme gists:core ;
    skos:note "If you are using temporal relations involving addresses, this category should be used to qualify the temporal relation rather than the address itself, since the same address may have different uses in different contexts, by different people and organizations, or at different times." .

gists:Assignment a owl:Class ;
    rdfs:label "Assignment" ;
    rdfs:subClassOf gists:TemporalRelation ;
    skos:altLabel "Assignment" ;
    skos:closeMatch <https://w3id.org/lmodel/common_domain_model/Counterparty>,
        <https://w3id.org/lmodel/common_domain_model/NaturalPersonRole>,
        <https://w3id.org/lmodel/common_domain_model/RelatedParty> ;
    skos:definition "A temporal relationship between an assignee, the thing assigned, and the resource that made the assignment." ;
    skos:editorialNote "OWL equivalentClass: (gist:TemporalRelation & ∃hasGiver.owl:Thing & ∃isAssignmentOf.owl:Thing & ∃isAssignmentTo.owl:Thing)" ;
    skos:exactMatch gist:Assignment ;
    skos:inScheme gists:core ;
    skos:note "Based on the Open World Assumption, the assigner may not be asserted or known.",
        "For some assignments, such as the assignment of a person to a task, it may seem equally correct in ordinary speech to say it is an assignment of a task to a person. Since gist:isAssignmentTo and gist:isAssignmentOf have no formal domains or ranges, the choice of which predicate to use for which is left as an implementation decision. Consistency is a key consideration." .

gists:Building a owl:Class ;
    rdfs:label "Building" ;
    rdfs:subClassOf gists:Landmark ;
    skos:altLabel "Building" ;
    skos:definition "A relatively permanent man-made structure situated on a plot of land, having a roof and walls, commonly used for dwelling, entertaining, or working." ;
    skos:exactMatch gist:Building ;
    skos:inScheme gists:core ;
    skos:note "User discretion can be applied to edge cases: e.g., is a traditional yurt 'relatively permanently situated' although it is portable and has a tent-like construction?" .

gists:BundledCatalogItem a owl:Class ;
    rdfs:label "BundledCatalogItem" ;
    rdfs:subClassOf gists:CatalogItem ;
    skos:altLabel "Bundled Catalog Item" ;
    skos:definition "Any combination of descriptions of things offered together." ;
    skos:editorialNote "OWL equivalentClass: (gist:CatalogItem & ∃^isDirectPartOf.gist:CatalogItem)" ;
    skos:exactMatch gist:BundledCatalogItem ;
    skos:inScheme gists:core .

gists:ContemporaryEvent a owl:Class ;
    rdfs:label "ContemporaryEvent" ;
    rdfs:subClassOf gists:Event ;
    skos:altLabel "Contemporary Event" ;
    skos:definition "An event that has started but has not yet ended." ;
    skos:editorialNote "OWL equivalentClass: (gist:Event & =1actualStartDateTime & ≤0actualEndDateTime)" ;
    skos:exactMatch gist:ContemporaryEvent ;
    skos:inScheme gists:core ;
    skos:note "When the event actually ends, it will cease being contemporary." .

gists:ContingentEvent a owl:Class ;
    rdfs:label "ContingentEvent" ;
    rdfs:subClassOf gists:Event ;
    skos:altLabel "Contingent Event" ;
    skos:definition "An event with a probability of happening in the future, and usually dependent upon some other event or condition." ;
    skos:editorialNote "OWL equivalentClass: (gist:Event & ∃hasMagnitude.∃hasAspect=_Aspect_probability & ∃isTriggeredBy.gist:Event)" ;
    skos:exactMatch gist:ContingentEvent ;
    skos:inScheme gists:core .

gists:Contract a owl:Class ;
    rdfs:label "Contract" ;
    rdfs:subClassOf gists:Agreement ;
    skos:altLabel "Contract" ;
    skos:definition "An agreement which can be enforced by law." ;
    skos:editorialNote "OWL equivalentClass: (gist:Agreement & ∃isUnderJurisdictionOf.gist:GovernmentOrganization)" ;
    skos:exactMatch <https://w3id.org/lmodel/dpvs/DpvContract>,
        gist:Contract ;
    skos:inScheme gists:core .

gists:ContractTerm a owl:Class ;
    rdfs:label "ContractTerm" ;
    rdfs:subClassOf gists:Specification ;
    skos:altLabel "Contract Term" ;
    skos:definition "A specification of some aspect of a contract." ;
    skos:exactMatch gist:ContractTerm ;
    skos:inScheme gists:core ;
    skos:relatedMatch <https://w3id.org/lmodel/common_domain_model/CollateralProvisions> .

gists:ControlledVocabulary a owl:Class ;
    rdfs:label "ControlledVocabulary" ;
    rdfs:subClassOf gists:Collection ;
    skos:altLabel "Controlled Vocabulary" ;
    skos:definition "A collection of terms approved and managed by some organization or person." ;
    skos:editorialNote "OWL equivalentClass: (gist:Collection & ∃isGovernedBy.(gist:Organization | gist:Person) & ∃^isMemberOf.gist:Category)" ;
    skos:exactMatch gist:ControlledVocabulary ;
    skos:inScheme gists:core ;
    skos:note "A controlled vocabulary is similar to a skos:ConceptScheme, but it could also be used for things that are not concepts, such as organizations, US presidents, geographic regions, etc. Hierarchical relationships between instances of the controlled vocabulary are possible." .

gists:CountryGeoRegion a owl:Class ;
    rdfs:label "CountryGeoRegion" ;
    rdfs:subClassOf gists:GovernedGeoRegion ;
    skos:altLabel "Country Geographic Region" ;
    skos:definition "A geographic region governed by exactly one country government." ;
    skos:editorialNote "OWL equivalentClass: (gist:GovernedGeoRegion & ∃isGovernedBy.gist:CountryGovernment)",
        "OWL subClassOf restrictions: =1isGovernedBy" ;
    skos:exactMatch gist:CountryGeoRegion ;
    skos:inScheme gists:core .

gists:CountryGovernment a owl:Class ;
    rdfs:label "CountryGovernment" ;
    rdfs:subClassOf gists:GovernmentOrganization ;
    skos:altLabel "Country Government" ;
    skos:definition "A government organization which asserts both sovereignty (i.e., it is not governed by some other government organization) and governance over an entity generally recognized as a country." ;
    skos:editorialNote "OWL equivalentClass: (gist:GovernmentOrganization & ∃^isGovernedBy.gist:CountryGeoRegion)",
        "OWL subClassOf restrictions: ≤0isGovernedBy.gist:GovernmentOrganization; _bnode_" ;
    skos:exactMatch gist:CountryGovernment ;
    skos:inScheme gists:core ;
    skos:note "While a country government may enter into treaties with other country governments, there are no governing relationships among the treaty members." .

gists:DegreeOfCommitment a owl:Class ;
    rdfs:label "DegreeOfCommitment" ;
    rdfs:subClassOf gists:Category ;
    skos:altLabel "Degree Of Commitment" ;
    skos:definition "The difficulty of reversing a commitment." ;
    skos:exactMatch gist:DegreeOfCommitment ;
    skos:inScheme gists:core .

gists:Determination a owl:Class ;
    rdfs:label "Determination" ;
    rdfs:subClassOf gists:Event ;
    skos:altLabel "Determination" ;
    skos:closeMatch <https://w3id.org/lmodel/iso22989/Decision> ;
    skos:definition "An event whose purpose is to establish a specific result, value, or outcome, usually by research, measuring, evaluating, or calculating." ;
    skos:exactMatch gist:Determination ;
    skos:inScheme gists:core .

gists:Discipline a owl:Class ;
    rdfs:label "Discipline" ;
    rdfs:subClassOf gists:Category ;
    skos:altLabel "Discipline" ;
    skos:definition "An area of study or practice." ;
    skos:exactMatch gist:Discipline ;
    skos:inScheme gists:core .

gists:ElectronicAddress a owl:Class ;
    rdfs:label "ElectronicAddress" ;
    rdfs:subClassOf gists:Address ;
    skos:altLabel "Electronic Address",
        "Virtual Address" ;
    skos:closeMatch <https://w3id.org/lmodel/common_domain_model/ContactInformation> ;
    skos:definition "An address referring to a locatable virtual place that does not physically exist but is made by software or electronics to appear to do so." ;
    skos:exactMatch gist:ElectronicAddress ;
    skos:inScheme gists:core .

gists:ElectronicAddressType a owl:Class ;
    rdfs:label "ElectronicAddressType" ;
    rdfs:subClassOf gists:Category ;
    skos:altLabel "Electronic Address Type" ;
    skos:definition "A category indicating a kind of electronic address. Such a category is usually based on the technology that enables routing to the address referent." ;
    skos:exactMatch gist:ElectronicAddressType ;
    skos:inScheme gists:core .

gists:EquipmentType a owl:Class ;
    rdfs:label "EquipmentType" ;
    rdfs:subClassOf gists:Category ;
    skos:altLabel "Equipment Type" ;
    skos:definition "A category of equipment." ;
    skos:exactMatch gist:EquipmentType ;
    skos:inScheme gists:core .

gists:EventSpecification a owl:Class ;
    rdfs:label "EventSpecification" ;
    rdfs:subClassOf gists:Specification ;
    skos:altLabel "Event Specification" ;
    skos:definition "A characterization of an event that might happen." ;
    skos:exactMatch gist:EventSpecification ;
    skos:inScheme gists:core ;
    skos:note "This concept is useful for risk assessment and insurance policies." .

gists:Function a owl:Class ;
    rdfs:label "Function" ;
    rdfs:subClassOf gists:Intention ;
    skos:altLabel "Function" ;
    skos:definition "The activity that a human-made item is intended to perform." ;
    skos:exactMatch gist:Function ;
    skos:inScheme gists:core .

gists:GeneralMediaType a owl:Class ;
    rdfs:label "GeneralMediaType" ;
    rdfs:subClassOf gists:Category ;
    skos:altLabel "General Media Type" ;
    skos:definition "The real-world media type for content." ;
    skos:exactMatch gist:GeneralMediaType ;
    skos:inScheme gists:core .

gists:GeoRoute a owl:Class ;
    rdfs:label "GeoRoute" ;
    rdfs:subClassOf gists:OrderedCollection ;
    skos:altLabel "Geographic Route" ;
    skos:definition "An ordered set of geographic points that defines a path from a starting point to an ending point." ;
    skos:editorialNote "OWL equivalentClass: (gist:OrderedCollection & ∃^isMemberOf.gist:GeoPoint)" ;
    skos:exactMatch gist:GeoRoute ;
    skos:inScheme gists:core ;
    skos:note "A geographic route could describe a bus route by identifying the points where the bus stops. A geographic route could describe the boundary of a polygonal geographic region (it does not have to be a traveled route)." .

gists:GeoVolume a owl:Class ;
    rdfs:label "GeoVolume" ;
    rdfs:subClassOf gists:GeoLocation ;
    skos:altLabel "Geographic Volume" ;
    skos:definition "A three-dimensional space on or near the surface of the Earth." ;
    skos:editorialNote "OWL equivalentClass: (gist:GeoLocation & ∃hasMagnitude.∃hasAspect=_Aspect_volume & ∃^isGeoContainedIn.gist:GeoPoint)" ;
    skos:exactMatch gist:GeoVolume ;
    skos:inScheme gists:core .

gists:HistoricalEvent a owl:Class ;
    rdfs:label "HistoricalEvent" ;
    rdfs:subClassOf gists:Event ;
    skos:altLabel "Historical Event" ;
    skos:definition "An event which occurred in time, with an actual end earlier than the present moment." ;
    skos:editorialNote "OWL equivalentClass: (gist:Event & ∃actualEndDateTime.<http://www.w3.org/2001/XMLSchema#dateTime>)",
        "OWL subClassOf restrictions: ∃actualStartDateTime.<http://www.w3.org/2001/XMLSchema#dateTime>" ;
    skos:exactMatch gist:HistoricalEvent ;
    skos:inScheme gists:core .

gists:IntergovernmentalOrganization a owl:Class ;
    rdfs:label "IntergovernmentalOrganization" ;
    rdfs:subClassOf gists:Organization ;
    skos:altLabel "Intergovernmental Organization" ;
    skos:definition "An organization whose members are government organizations. This can comprise regional, municipal, state/province, or national level entities." ;
    skos:editorialNote "OWL equivalentClass: (gist:Organization & ≥2^isMemberOf.gist:GovernmentOrganization)" ;
    skos:exactMatch gist:IntergovernmentalOrganization ;
    skos:inScheme gists:core .

gists:KnowledgeConcept a owl:Class ;
    rdfs:label "KnowledgeConcept" ;
    rdfs:subClassOf gists:IntellectualProperty ;
    skos:altLabel "Knowledge Concept" ;
    skos:definition "An abstract concept that arises from the distillation of experience. It is similar to a category but, rather than being a simple tag, it has rich structure." ;
    skos:exactMatch gist:KnowledgeConcept ;
    skos:inScheme gists:core ;
    skos:note """Some knowledge is about specific instances that already exist in the knowledge graph. We may have knowledge that Judge Jones is more lenient on repeat offenders in the morning; we may know that the earliest killing frost in Fort Collins is the last week of September.\r
\r
These fit the broader definition of knowledge, the distillation of experience. But they do not require any new instances. Judge Jones and Fort Collins already exist and have a place in our knowledge graph.\r
\r
But some knowledge requires that we synthesize new instances in order to have a place to consolidate the knowledge. A disease isn't a tangible thing, like a person or a building. A disease is a prediction that a person's health will decline in a predictable way (without treatment and with treatment). The number of diseases continues to grow as we collectively learn more and more granular distinctions. Lung cancer used to be a single disease, but now we have dozens of fine-grained distinctions; e.g., non-lymphoma small cell fusiform is different from alveolar adenocarcinoma because we now know the prognosis and treatment are different.\r
\r
This superclass is meant as a place for subclasses that will have the instances that represent the foci of the knowledge we have acquired. Note the distinction between a particular portion of, say, gold, which instantiates gist:PhysicalSubstance, and the concept of gold, which instantiates gist:KnowledgeConcept.\r
\r
In some ontologies what we are calling knowledge concepts are defined as classes; e.g., non-lymphoma small cell fusiform and alveolar adenocarcinoma would be two classes rather than two instances. But using a class makes it harder to connect the concept to other instances in a knowledge graph, and furthermore such classes would lack instances.""" ;
    skos:relatedMatch <https://w3id.org/lmodel/iso22989/KnowledgeGraph> .

gists:MediaType a owl:Class ;
    rdfs:label "MediaType" ;
    rdfs:subClassOf gists:Category ;
    skos:altLabel "Media Type" ;
    skos:definition "A digitized type that computer applications can recognize." ;
    skos:editorialNote "OWL subClassOf restrictions: ∃uniqueText.<http://www.w3.org/2001/XMLSchema#string>" ;
    skos:exactMatch gist:MediaType ;
    skos:inScheme gists:core ;
    skos:note "The unique text for an IANA media type is the concatenation of the 'Type name', a slash '/', and the 'Subtype name' as provided on the page displayed when you resolve the URI of the media type." .

gists:Medium a owl:Class ;
    rdfs:label "Medium" ;
    rdfs:subClassOf gists:Category ;
    skos:altLabel "Medium" ;
    skos:definition "A physical material on which a work can be rendered, represented, or implemented." ;
    skos:exactMatch gist:Medium ;
    skos:inScheme gists:core .

gists:Message a owl:Class ;
    rdfs:label "Message" ;
    rdfs:subClassOf gists:ContentExpression ;
    skos:altLabel "Message" ;
    skos:definition "A specific instance of content sent from a sender to at least one other recipient." ;
    skos:editorialNote "OWL equivalentClass: (gist:ContentExpression & ∃comesFromAgent.(gist:Organization | gist:Person) & ∃goesToAgent.(gist:Organization | gist:Person))" ;
    skos:exactMatch gist:Message ;
    skos:inScheme gists:core .

gists:Network a owl:Class ;
    rdfs:label "Network" ;
    rdfs:subClassOf gists:Composite ;
    skos:altLabel "Network" ;
    skos:definition "A composite consisting of nodes connected by links." ;
    skos:editorialNote "OWL equivalentClass: (gist:Composite & ∃^isMemberOf.(gist:NetworkLink | gist:NetworkNode))" ;
    skos:exactMatch gist:Network ;
    skos:inScheme gists:core .

gists:NetworkLink a owl:Class ;
    rdfs:label "NetworkLink" ;
    rdfs:subClassOf gists:Component ;
    skos:altLabel "Network Link" ;
    skos:definition "An abstract representation of the connection between two or more nodes in a network." ;
    skos:editorialNote "OWL equivalentClass: (gist:Component & ∃isMemberOf.gist:Network & ∃links.gist:NetworkNode)",
        "OWL subClassOf restrictions: =2links; ∀links.gist:NetworkNode" ;
    skos:exactMatch gist:NetworkLink ;
    skos:inScheme gists:core ;
    skos:note "Each network link is connected to a network node via the property gist:links or one of its subproperties." .

gists:Offer a owl:Class ;
    rdfs:label "Offer" ;
    rdfs:subClassOf gists:ContingentObligation ;
    skos:altLabel "Offer" ;
    skos:definition "A contingent commitment to buy, sell, swap or provide one or more described or identified goods or services in exchange for another (or others)." ;
    skos:editorialNote "OWL equivalentClass: (gist:ContingentObligation & ∃hasGiver.(gist:Organization | gist:Person) & ∃offersToProvide.owl:Thing & ∃offersToReceive.owl:Thing & ∃plannedEndDateTime.<http://www.w3.org/2001/XMLSchema#dateTime> & ∃plannedStartDateTime.<http://www.w3.org/2001/XMLSchema#dateTime>)" ;
    skos:exactMatch gist:Offer ;
    skos:inScheme gists:core ;
    skos:note "Dates on an offer represent the time period the offer is valid for, as in '25% off through October 25, 2025.'" .

gists:Permission a owl:Class ;
    rdfs:label "Permission" ;
    rdfs:subClassOf gists:Intention ;
    skos:altLabel "Permission" ;
    skos:definition "A description of things one is permitted to do." ;
    skos:editorialNote "OWL equivalentClass: (gist:Intention & ∃allows.gist:Behavior)" ;
    skos:exactMatch <https://w3id.org/lmodel/dpvs/Permission>,
        gist:Permission ;
    skos:inScheme gists:core .

gists:PhysicalActionType a owl:Class ;
    rdfs:label "PhysicalActionType" ;
    rdfs:subClassOf gists:Category ;
    skos:altLabel "Physical Action Type" ;
    skos:definition "A category indicating the type of an action based on its effect in the physical world." ;
    skos:exactMatch gist:PhysicalActionType ;
    skos:inScheme gists:core .

gists:PhysicalAddress a owl:Class ;
    rdfs:label "PhysicalAddress" ;
    rdfs:subClassOf gists:Address ;
    skos:altLabel "Physical Address" ;
    skos:definition "An address that refers to a locatable place within the physical universe." ;
    skos:editorialNote "OWL equivalentClass: (gist:Address & ∃refersTo.gist:GeoLocation)" ;
    skos:exactMatch gist:PhysicalAddress ;
    skos:inScheme gists:core ;
    skos:relatedMatch <https://w3id.org/lmodel/common_domain_model/Address> .

gists:PhysicalAddressType a owl:Class ;
    rdfs:label "PhysicalAddressType" ;
    rdfs:subClassOf gists:Category ;
    skos:altLabel "Physical Address Type" ;
    skos:definition "A category indicating local customary characterizations of physical addresses." ;
    skos:exactMatch gist:PhysicalAddressType ;
    skos:inScheme gists:core .

gists:PhysicalEvent a owl:Class ;
    rdfs:label "PhysicalEvent" ;
    rdfs:subClassOf gists:Event ;
    skos:altLabel "Physical Event" ;
    skos:definition "An event that can be said to have occurred at some place in space." ;
    skos:editorialNote "OWL equivalentClass: (gist:Event & ∃occursIn.gist:GeoLocation)" ;
    skos:exactMatch gist:PhysicalEvent ;
    skos:inScheme gists:core .

gists:ProductCategory a owl:Class ;
    rdfs:label "ProductCategory" ;
    rdfs:subClassOf gists:Category ;
    skos:altLabel "Product Category" ;
    skos:definition "Any of many ways of categorizing products." ;
    skos:exactMatch gist:ProductCategory ;
    skos:inScheme gists:core .

gists:ProductSpecification a owl:Class ;
    rdfs:label "ProductSpecification" ;
    rdfs:subClassOf gists:CatalogItem ;
    skos:altLabel "Product Specification" ;
    skos:closeMatch <https://w3id.org/lmodel/common_domain_model/TradableProduct> ;
    skos:definition "A description of something that could be physically warehoused or digitally stored and physically or digitally delivered." ;
    skos:editorialNote "OWL equivalentClass: (gist:CatalogItem & ∃isCategorizedBy.gist:ProductCategory)" ;
    skos:exactMatch gist:ProductSpecification ;
    skos:inScheme gists:core .

gists:Project a owl:Class ;
    rdfs:label "Project" ;
    rdfs:subClassOf gists:Task ;
    skos:altLabel "Project" ;
    skos:definition "A task, usually of longer duration, made up of other tasks." ;
    skos:editorialNote "OWL equivalentClass: (gist:Task & ∃^isPartOf.gist:Task)" ;
    skos:exactMatch gist:Project ;
    skos:inScheme gists:core .

gists:ReferenceValue a owl:Class ;
    rdfs:label "ReferenceValue" ;
    rdfs:subClassOf gists:Magnitude ;
    skos:altLabel "Reference Value" ;
    skos:definition "A magnitude that was neither measured nor estimated but set by fiat." ;
    skos:exactMatch gist:ReferenceValue ;
    skos:inScheme gists:core .

gists:RenderedContent a owl:Class ;
    rdfs:label "RenderedContent" ;
    rdfs:subClassOf gists:FormattedContent ;
    skos:altLabel "Rendered Content" ;
    skos:definition "Content expressed via some physical medium." ;
    skos:editorialNote "OWL equivalentClass: (gist:FormattedContent & ∃isRenderedOn.gist:Medium)" ;
    skos:exactMatch gist:RenderedContent ;
    skos:inScheme gists:core ;
    skos:note "Renderings of the same file on two different monitors are separate instances of rendered content." .

gists:Requirement a owl:Class ;
    rdfs:label "Requirement" ;
    rdfs:subClassOf gists:Intention ;
    skos:altLabel "Requirement" ;
    skos:definition "The obligation of a person or organization to behave in a certain way." ;
    skos:exactMatch gist:Requirement ;
    skos:inScheme gists:core .

gists:Restriction a owl:Class ;
    rdfs:label "Restriction" ;
    rdfs:subClassOf gists:Intention ;
    skos:altLabel "Restriction" ;
    skos:definition "A description of things one is prevented from doing." ;
    skos:editorialNote "OWL equivalentClass: (gist:Intention & ∃prevents.gist:Behavior)" ;
    skos:exactMatch gist:Restriction ;
    skos:inScheme gists:core .

gists:ScheduledTask a owl:Class ;
    rdfs:label "ScheduledTask" ;
    rdfs:subClassOf gists:ScheduledEvent ;
    skos:altLabel "Scheduled Task" ;
    skos:definition "A task with a planned start datetime." ;
    skos:editorialNote "Additional named superclasses (modelled as OWL multiple inheritance): Task",
        "OWL equivalentClass: (gist:ScheduledEvent & gist:Task)" ;
    skos:exactMatch gist:ScheduledTask ;
    skos:inScheme gists:core ;
    skos:note "If work on the task has already started, but has not yet ended, it will have an actual start datetime. If the task is completed, it will also have an actual end datetime. The task always retains its planned start time, and thus continues to be a scheduled task." .

gists:SchemaMetaData a owl:Class ;
    rdfs:label "SchemaMetaData" ;
    rdfs:subClassOf gists:GistThing ;
    skos:altLabel "Schema Meta Data" ;
    skos:definition "Superclass for all types of metadata." ;
    skos:exactMatch gist:SchemaMetaData ;
    skos:inScheme gists:core ;
    skos:note "The definition of this class needs additional work." .

gists:ServiceSpecification a owl:Class ;
    rdfs:label "ServiceSpecification" ;
    rdfs:subClassOf gists:CatalogItem ;
    skos:altLabel "Service Specification" ;
    skos:definition "A description of something that can be done for a person or organization (which produces some form of an act)." ;
    skos:editorialNote "OWL equivalentClass: (gist:CatalogItem & ∃^isBasedOn.gist:Event)" ;
    skos:exactMatch gist:ServiceSpecification ;
    skos:inScheme gists:core .

gists:SubCountryGovernment a owl:Class ;
    rdfs:label "SubCountryGovernment" ;
    rdfs:subClassOf gists:GovernmentOrganization ;
    skos:altLabel "Sub-Country Government" ;
    skos:definition "The government of a governed geographic region other than a country which is under the direct or indirect control of a country government." ;
    skos:editorialNote "OWL equivalentClass: (gist:GovernmentOrganization & ∃isGovernedBy.gist:CountryGovernment & ∃^isGovernedBy.gist:GeoRegion)" ;
    skos:exactMatch gist:SubCountryGovernment ;
    skos:inScheme gists:core ;
    skos:note "Note that the predicate gist:isGovernedBy is used both for the relationship a governed geographic region has to its government and for the relationship a sub-region government has to the government of the larger region.",
        "There are many types of sub-regions of a country and the governments thereof (as well as different terms, like 'province' and 'state,' which refer to essentially the same type of thing). We should not automatically assume 'state,' 'county,' and 'city.' Subclasses or categories can be defined if greater specificity is needed.",
        "This class applies only to organizations governing geographic regions. Regulatory and bureaucratic organizations are members of the more generic gist:GovernmentOrganization class." .

gists:System a owl:Class ;
    rdfs:label "System" ;
    rdfs:subClassOf gists:Composite ;
    skos:altLabel "System" ;
    skos:definition "A composite made up of interacting or interdependent components that together operate as a whole." ;
    skos:editorialNote "OWL equivalentClass: (gist:Composite & ∃^isDirectPartOf.gist:Component)" ;
    skos:exactMatch gist:System ;
    skos:inScheme gists:core ;
    skos:note "May be used to refer to either man-made or natural systems." .

gists:Tag a owl:Class ;
    rdfs:label "Tag" ;
    rdfs:subClassOf gists:Category ;
    skos:altLabel "Tag" ;
    skos:definition "A term in a folksonomy used to categorize things. Tags can be made up on the fly by users." ;
    skos:editorialNote "OWL subClassOf restrictions: ∃containedText.<http://www.w3.org/2001/XMLSchema#string>" ;
    skos:exactMatch gist:Tag ;
    skos:inScheme gists:core ;
    skos:note "Whether to use gist:containedText or gist:uniqueText on tags is an implementation decision. Since the latter is a subproperty of the former, the restriction remains valid either way." .

gists:TaskTemplate a owl:Class ;
    rdfs:label "TaskTemplate" ;
    rdfs:subClassOf gists:Template ;
    skos:altLabel "Task Template" ;
    skos:definition "An outline of a task of a particular type, which is the basis for executing such tasks." ;
    skos:editorialNote "OWL equivalentClass: (gist:Template & ∃hasGoal.gist:Intention)" ;
    skos:exactMatch gist:TaskTemplate ;
    skos:inScheme gists:core ;
    skos:note "A task template may define a single activity or a series of activities; the level of granularity can be varied according to use case. For example, in a new employee onboarding process, signing up for benefits might be one activity, or it might be broken down into signing up for health insurance, signing up for dental insurance, etc.",
        "Use the property isBasedOn to link the Task back to the TaskTemplate." .

gists:Text a owl:Class ;
    rdfs:label "Text" ;
    rdfs:subClassOf gists:ContentExpression ;
    skos:altLabel "Text" ;
    skos:definition "Content expressed as a written sequence of characters." ;
    skos:editorialNote "OWL equivalentClass: (gist:ContentExpression & ∃isExpressedIn.gist:Language & ∃containedText.<http://www.w3.org/2001/XMLSchema#string>)" ;
    skos:exactMatch gist:Text ;
    skos:inScheme gists:core ;
    skos:note "Text is expressed in a language (human or computer) and may but need not specify an encoding." .

gists:TimeInterval a owl:Class ;
    rdfs:label "TimeInterval" ;
    rdfs:subClassOf gists:GistThing ;
    skos:altLabel "Time Interval" ;
    skos:closeMatch <https://w3id.org/lmodel/common_domain_model/Period> ;
    skos:definition "A span of time with a known start time, end time, and duration. As long as two of the three are known, the third can be inferred." ;
    skos:editorialNote "OWL subClassOf restrictions: =1endDateTime; _bnode_; =1startDateTime" ;
    skos:exactMatch gist:TimeInterval ;
    skos:inScheme gists:core ;
    skos:note "An ongoing state of affairs with an unknown end time in the future cannot be a time interval; e.g. the lifespan of a living person cannot be a time interval, as the end time is unknown.",
        "This is distinct from a duration, which describes how long a time interval lasts (e.g., one hour; 3 days; 22 minutes)." .

gists:Transaction a owl:Class ;
    rdfs:label "Transaction" ;
    rdfs:subClassOf gists:Event ;
    skos:altLabel "Transaction" ;
    skos:closeMatch <https://w3id.org/lmodel/common_domain_model/Trade> ;
    skos:definition "An exchange or transfer of goods, services, or funds." ;
    skos:exactMatch gist:Transaction ;
    skos:inScheme gists:core ;
    skos:note "Different sorts of transactions can have different datetime precisions. For example, an electronic transaction would have a gist:actualEndMicrosecond." ;
    skos:relatedMatch <https://w3id.org/lmodel/common_domain_model/TradeState> .

gists:actual_end_microsecond a owl:DatatypeProperty ;
    rdfs:label "actual_end_microsecond" ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf gists:actual_end_date_time ;
    skos:altLabel "actual end microsecond" ;
    skos:definition "The actual time that something ended, expressed as a system time used for timestamps." ;
    skos:inScheme gists:core ;
    skos:note "A system time will be as precise as the system can supply, typically at least milliseconds, sometimes microseconds. The convention for timestamps, such as recording a transaction, is to specify just the end point; the start time is rarely needed." .

gists:actual_end_minute a owl:DatatypeProperty ;
    rdfs:label "actual_end_minute" ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf gists:actual_end_date_time ;
    skos:altLabel "actual end minute" ;
    skos:definition "The actual date and time that something ended, with precision of one minute." ;
    skos:inScheme gists:core ;
    skos:note "Used for things like meetings and time card entries, where the hour and minute are important. Recommended usage is to zero out the seconds and microseconds to avoid spurious precision." .

gists:actual_end_year a owl:DatatypeProperty ;
    rdfs:label "actual_end_year" ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf gists:actual_end_date_time ;
    skos:altLabel "actual end year" ;
    skos:definition "The actual date that something ended, with precision of one year." ;
    skos:inScheme gists:core ;
    skos:note "Used for things where the precision of a year is sufficient. Recommended usage is to zero out the hours through microseconds to avoid spurious precision. Note that it is not valid to zero out months and days, so arbitrary values must be included." .

gists:actual_start_date a owl:DatatypeProperty ;
    rdfs:label "actual_start_date" ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf gists:actual_start_date_time ;
    skos:altLabel "actual start date" ;
    skos:definition "The actual date that something started, with precision of one day." ;
    skos:inScheme gists:core ;
    skos:note "Used for things where the precision of a date is sufficient, such as most projects, tasks, and the like. Recommended usage is to zero out the hours through microseconds to avoid spurious precision." .

gists:actual_start_microsecond a owl:DatatypeProperty ;
    rdfs:label "actual_start_microsecond" ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf gists:actual_start_date_time ;
    skos:altLabel "actual start microsecond" ;
    skos:definition "The actual time that something started, expressed as a system time used for timestamps." ;
    skos:inScheme gists:core ;
    skos:note "A system time will be as precise as the system can supply, typically at least milliseconds, sometimes microseconds. The convention for timestamps, such as recording a transaction, is to specify just the end point; the start time is rarely needed. This property is defined for the cases when you do need to capture the runtime of a system process, and is then used in conjunction with gist:actualEndMicrosecond." .

gists:actual_start_minute a owl:DatatypeProperty ;
    rdfs:label "actual_start_minute" ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf gists:actual_start_date_time ;
    skos:altLabel "actual start minute" ;
    skos:definition "The actual date and time that something started, with precision of one minute." ;
    skos:inScheme gists:core ;
    skos:note "Used for things like meetings and time card entries, where the hour and minute are important. Recommended usage is to zero out the seconds and microseconds to avoid spurious precision." .

gists:actual_start_year a owl:DatatypeProperty ;
    rdfs:label "actual_start_year" ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf gists:actual_start_date_time ;
    skos:altLabel "actual start year" ;
    skos:definition "The actual date that something started, with precision of one year." ;
    skos:inScheme gists:core ;
    skos:note "Used for things where the precision of a year is sufficient. Recommended usage is to zero out the hours through microseconds to avoid spurious precision. Note that it is not valid to zero out months and days, so arbitrary values must be included." .

gists:allows a owl:DatatypeProperty ;
    rdfs:label "allows" ;
    skos:altLabel "allows" ;
    skos:definition "Relates a permission to a particular activity or type of activity it allows." ;
    skos:inScheme gists:core .

gists:birth_date a owl:DatatypeProperty ;
    rdfs:label "birth_date" ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf gists:start_date_time ;
    skos:altLabel "birth date" ;
    skos:definition "The date some living thing was or will be born, with precision of one day." ;
    skos:inScheme gists:core ;
    skos:note "This is a subproperty of gist:startDateTime rather than gist:actualStartDate because some living things have yet to be born. This property refers to a calendar date and is assumed to precision of one day (time zone offset is allowed). It is recommended to zero out the hours through microseconds to avoid spurious precision. Implementations requiring a birthdate to the minute can define a subproperty." .

gists:comes_from_agent a owl:DatatypeProperty ;
    rdfs:label "comes_from_agent" ;
    rdfs:range [ owl:unionOf ( gists:Organization gists:Person ) ] ;
    rdfs:subPropertyOf gists:has_participant ;
    skos:altLabel "comes from agent" ;
    skos:definition "Relates something to the originating agent." ;
    skos:inScheme gists:core ;
    skos:note "This is not the inverse of gist:goesToAgent, as both properties have the message or shipment as the subject.",
        "This property is intended to describe the physical or electronic transfer of something, such as a package or email, from one agent to another, whereas gist:hasGiver is typically used in more abstract contexts such as agreements, obligations, contracts, etc. However, there are contexts in which either may be appropriate, such as the giving of a gift." .

gists:comes_from_place a owl:DatatypeProperty ;
    rdfs:label "comes_from_place" ;
    rdfs:range [ owl:unionOf ( gists:Address gists:GeoLocation ) ] ;
    skos:altLabel "comes from place" ;
    skos:definition "Relates something to its place of origin." ;
    skos:inScheme gists:core .

gists:conforms_to a owl:ObjectProperty ;
    rdfs:label "conforms_to" ;
    rdfs:range gists:Intention ;
    skos:altLabel "conforms to" ;
    skos:definition "The subject is consistent with or satisfies the requirements, rules, or expectations established by the object." ;
    skos:inScheme gists:core .

gists:contributes_to a owl:DatatypeProperty ;
    rdfs:label "contributes_to" ;
    skos:altLabel "contributes to" ;
    skos:definition "The subject helps achieve or fulfill the goals or functions of the object." ;
    skos:inScheme gists:core .

gists:conversion_factor a owl:DatatypeProperty ;
    rdfs:label "conversion_factor" ;
    rdfs:domain gists:UnitOfMeasure ;
    skos:altLabel "conversion factor" ;
    skos:definition "A value that relates a unit of measure to units of the International System of Units." ;
    skos:editorialNote "OWL FunctionalProperty (at most one value)" ;
    skos:inScheme gists:core ;
    skos:note """To convert a numeric value from one unit of measure to another, multiply by the conversion factor of the first unit and then divide by the conversion factor of the second unit.\r
\r
	For example, to convert 27 feet to yards:\r
\r
		the conversion factor of foot is 0.3048\r
		the conversion factor of yard is 0.9144\r
\r
		so\r
\r
		27 feet = (27 x 0.3048) / 0.9144 = 9 yards""" .

gists:conversion_offset a owl:DatatypeProperty ;
    rdfs:label "conversion_offset" ;
    rdfs:domain gists:UnitOfMeasure ;
    rdfs:range xsd:decimal ;
    skos:altLabel "conversion offset" ;
    skos:definition """\r
		A value used along with a conversion factor to relate a unit to its corresponding unit in the International System of Units. In the equation below, the conversion offset is 459.669607 and the conversion factor is 5/9.\r
\r
		y degrees Fahrenheit = (y + 459.669607) x 5/9 degrees Kelvin\r
\r
		To convert from Fahrenheit to Kelvin, first add the offset and then multiply by the conversion factor.\r
\r
		To convert from Kelvin to Fahrenheit, reverse the steps: first divide by the conversion factor and then subtract the offset.""" ;
    skos:editorialNote "OWL FunctionalProperty (at most one value)" ;
    skos:inScheme gists:core .

gists:death_date a owl:DatatypeProperty ;
    rdfs:label "death_date" ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf gists:actual_end_date ;
    skos:altLabel "death date" ;
    skos:definition "The date some living thing died." ;
    skos:inScheme gists:core ;
    skos:note "Refers to a calendar date and is assumed to have precision of one day (time zone offset is allowed). Recommended usage is to zero out the hours through microseconds to avoid spurious precision. Implementations requiring a death date to the minute can define a subproperty." .

gists:domain_includes a owl:DatatypeProperty ;
    rdfs:label "domain_includes" ;
    skos:altLabel "domain includes" ;
    skos:definition "Relates a property to a class that the property is expected to be used on." ;
    skos:inScheme gists:core ;
    skos:note "There may be multiple domainIncludes assertions on a single property.",
        "This property is used to guide the ontology user; like all annotation properties, it does not play a role in inference." ;
    skos:relatedMatch skos:scopeNote .

gists:encrypted_text a owl:DatatypeProperty ;
    rdfs:label "encrypted_text" ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf gists:contained_text ;
    skos:altLabel "encrypted text" ;
    skos:definition "Encoded text produced from readable data by an algorithm so that it can only be understood or restored with a decryption key." ;
    skos:inScheme gists:core .

gists:exponent_of_ampere a owl:DatatypeProperty ;
    rdfs:label "exponent_of_ampere" ;
    rdfs:domain gists:UnitGroup ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( [ owl:unionOf ( gists:UnitGroup gists:UnitOfMeasure ) ] xsd:decimal ) ] ;
    skos:altLabel "exponent of ampere" ;
    skos:definition "The exponent of ampere in a product of powers of base units." ;
    skos:inScheme gists:core .

gists:exponent_of_bit a owl:DatatypeProperty ;
    rdfs:label "exponent_of_bit" ;
    rdfs:domain gists:UnitGroup ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( [ owl:unionOf ( gists:UnitGroup gists:UnitOfMeasure ) ] xsd:decimal ) ] ;
    skos:altLabel "exponent of bit" ;
    skos:definition "The exponent of bit in a product of powers of base units." ;
    skos:inScheme gists:core .

gists:exponent_of_candela a owl:DatatypeProperty ;
    rdfs:label "exponent_of_candela" ;
    rdfs:domain gists:UnitGroup ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( [ owl:unionOf ( gists:UnitGroup gists:UnitOfMeasure ) ] xsd:decimal ) ] ;
    skos:altLabel "exponent of candela" ;
    skos:definition "The exponent of candela in a product of powers of base units." ;
    skos:inScheme gists:core .

gists:exponent_of_kelvin a owl:DatatypeProperty ;
    rdfs:label "exponent_of_kelvin" ;
    rdfs:domain gists:UnitGroup ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( [ owl:unionOf ( gists:UnitGroup gists:UnitOfMeasure ) ] xsd:decimal ) ] ;
    skos:altLabel "exponent of Kelvin" ;
    skos:definition "The exponent of Kelvin in a product of powers of base units." ;
    skos:inScheme gists:core .

gists:exponent_of_kilogram a owl:DatatypeProperty ;
    rdfs:label "exponent_of_kilogram" ;
    rdfs:domain gists:UnitGroup ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( [ owl:unionOf ( gists:UnitGroup gists:UnitOfMeasure ) ] xsd:decimal ) ] ;
    skos:altLabel "exponent of kilogram" ;
    skos:definition "The exponent of kilogram in a product of powers of base units." ;
    skos:inScheme gists:core .

gists:exponent_of_meter a owl:DatatypeProperty ;
    rdfs:label "exponent_of_meter" ;
    rdfs:domain gists:UnitGroup ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( [ owl:unionOf ( gists:UnitGroup gists:UnitOfMeasure ) ] xsd:decimal ) ] ;
    skos:altLabel "exponent of meter" ;
    skos:definition "The exponent of meter in a product of powers of base units." ;
    skos:inScheme gists:core .

gists:exponent_of_mole a owl:DatatypeProperty ;
    rdfs:label "exponent_of_mole" ;
    rdfs:domain gists:UnitGroup ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( [ owl:unionOf ( gists:UnitGroup gists:UnitOfMeasure ) ] xsd:decimal ) ] ;
    skos:altLabel "exponent of mole" ;
    skos:definition "The exponent of mole in a product of powers of base units." ;
    skos:inScheme gists:core .

gists:exponent_of_number a owl:DatatypeProperty ;
    rdfs:label "exponent_of_number" ;
    rdfs:domain gists:UnitGroup ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( [ owl:unionOf ( gists:UnitGroup gists:UnitOfMeasure ) ] xsd:decimal ) ] ;
    skos:altLabel "exponent of number" ;
    skos:definition "The exponent of number in a product of powers of base units." ;
    skos:inScheme gists:core ;
    skos:note "Use when the unit of measure involves a count or other number." .

gists:exponent_of_other a owl:DatatypeProperty ;
    rdfs:label "exponent_of_other" ;
    rdfs:domain gists:UnitGroup ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( [ owl:unionOf ( gists:UnitGroup gists:UnitOfMeasure ) ] xsd:decimal ) ] ;
    skos:altLabel "exponent of other" ;
    skos:definition "Indicates whether a unit of measure can be expressed in terms of the standard exponents (as shown in the examples)." ;
    skos:inScheme gists:core ;
    skos:note """Set the value to 0 if the units of measure in the unit group can be expressed using the standard set of exponents (as in the examples).\r
\r
		Otherwise set the value to 1, which typically means the units of measure in the group use a logarithmic scale.""" .

gists:exponent_of_radian a owl:DatatypeProperty ;
    rdfs:label "exponent_of_radian" ;
    rdfs:domain gists:UnitGroup ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( [ owl:unionOf ( gists:UnitGroup gists:UnitOfMeasure ) ] xsd:decimal ) ] ;
    skos:altLabel "exponent of radian" ;
    skos:definition "The exponent of radian in a product of powers of base units." ;
    skos:inScheme gists:core .

gists:exponent_of_second a owl:DatatypeProperty ;
    rdfs:label "exponent_of_second" ;
    rdfs:domain gists:UnitGroup ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( [ owl:unionOf ( gists:UnitGroup gists:UnitOfMeasure ) ] xsd:decimal ) ] ;
    skos:altLabel "exponent of second" ;
    skos:definition "The exponent of second in a product of powers of base units." ;
    skos:inScheme gists:core .

gists:exponent_of_steradian a owl:DatatypeProperty ;
    rdfs:label "exponent_of_steradian" ;
    rdfs:domain gists:UnitGroup ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( [ owl:unionOf ( gists:UnitGroup gists:UnitOfMeasure ) ] xsd:decimal ) ] ;
    skos:altLabel "exponent of steradian" ;
    skos:definition "The exponent of steradian in a product of powers of base units." ;
    skos:inScheme gists:core ;
    skos:note "Steradian is a measure of solid angle." .

gists:exponent_of_us_dollar a owl:DatatypeProperty ;
    rdfs:label "exponent_of_us_dollar" ;
    rdfs:domain gists:UnitGroup ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( [ owl:unionOf ( gists:UnitGroup gists:UnitOfMeasure ) ] xsd:decimal ) ] ;
    skos:altLabel "exponent of US dollar" ;
    skos:definition "The exponent of US Dollar in a product of powers of base units." ;
    skos:inScheme gists:core ;
    skos:note "The factors for converting from one currency to another change constantly." .

gists:goes_to_agent a owl:DatatypeProperty ;
    rdfs:label "goes_to_agent" ;
    rdfs:range [ owl:unionOf ( gists:Organization gists:Person ) ] ;
    rdfs:subPropertyOf gists:has_participant ;
    skos:altLabel "goes to agent" ;
    skos:definition "Relates something to the agent that receives it." ;
    skos:inScheme gists:core ;
    skos:note "This is not the inverse of gist:comesFromAgent, as both properties have the message or shipment as the subject.",
        "This property is intended to describe the physical or electronic transfer of something, such as a package or email, from one agent to another, whereas gist:hasRecipient is typically used in more abstract contexts such as agreements, obligations, contracts, etc. However, there are contexts in which either may be appropriate, such as the receiving of a gift." .

gists:goes_to_place a owl:DatatypeProperty ;
    rdfs:label "goes_to_place" ;
    rdfs:range [ owl:unionOf ( gists:Address gists:GeoLocation ) ] ;
    skos:altLabel "goes to place" ;
    skos:definition "Relates something to its destination place." ;
    skos:inScheme gists:core .

gists:has_accuracy a owl:ObjectProperty ;
    rdfs:label "has_accuracy" ;
    rdfs:range gists:Magnitude ;
    skos:altLabel "has accuracy" ;
    skos:definition "Relates a magnitude to another magnitude that describes its accuracy." ;
    skos:editorialNote "OWL FunctionalProperty (at most one value)" ;
    skos:inScheme gists:core ;
    skos:note """gist uses the ISO-5725 definition of accuracy, which is a combination of trueness (a measure of systemic error) and precision (a measure of random error). The accuracy of a measurement method describes how close its measurements are to actual values. Similarly, the accuracy of an individual measurement is its likely closeness to the actual value. When we say a temperature measurement is accurate to within a tenth of a degree, it means with a certain probability such as 95%.\r
\r
Note that the unit of measure of the accuracy has to be compatible with the unit of measure of the original magnitude (e.g. something measured in meters could have an accuracy in terms of millimeters or any other unit that measures distance).""" .

gists:has_addend a owl:DatatypeProperty ;
    rdfs:label "has_addend" ;
    skos:altLabel "has addend" ;
    skos:definition "Relates an aspect to another aspect that is an additive component of it." ;
    skos:inScheme gists:core ;
    skos:note "Commonly used with financial metrics." .

gists:has_address a owl:ObjectProperty ;
    rdfs:label "has_address" ;
    rdfs:range gists:Address ;
    skos:altLabel "has address" ;
    skos:definition "Relates something to its physical or electronic address." ;
    skos:inScheme gists:core .

gists:has_aspect a owl:ObjectProperty ;
    rdfs:label "has_aspect" ;
    rdfs:range gists:Aspect ;
    skos:altLabel "has aspect" ;
    skos:definition "Relates a magnitude to its aspect (measurable characteristic)." ;
    skos:editorialNote "OWL FunctionalProperty (at most one value)" ;
    skos:inScheme gists:core .

gists:has_biological_parent a owl:ObjectProperty ;
    rdfs:label "has_biological_parent" ;
    rdfs:domain gists:LivingThing ;
    rdfs:range gists:LivingThing ;
    skos:altLabel "has biological parent" ;
    skos:definition "Relates a living thing to its biological parent." ;
    skos:inScheme gists:core .

gists:has_direct_broader a owl:DatatypeProperty ;
    rdfs:label "has_direct_broader" ;
    rdfs:subPropertyOf gists:has_broader ;
    skos:altLabel "has direct broader" ;
    skos:definition "Relates a thing to another thing with a broader meaning, when there is no intermediate between them." ;
    skos:inScheme gists:core ;
    skos:note "Unlike gist:hasBroader, this property is not transitive. It is safest to use this property when semantic directness is inherent in the relationship. Otherwise, there is a risk of making a hasDirectBroader assertion and then later inserting an intermediate part; this will result in making an asserted triple false even though there was no change in the world. When in doubt, use the transitive version gist:hasBroader." .

gists:has_divisor a owl:DatatypeProperty ;
    rdfs:label "has_divisor" ;
    skos:altLabel "has divisor" ;
    skos:definition "Relates a unit of measure to another unit of measure that is a divisor, or relates an aspect to another aspect that is a divisor." ;
    skos:inScheme gists:core ;
    skos:note "Provides a supplemental method of decomposing a unit of measure or an aspect into component factors. Enables dimensional analysis such as miles per hour x hours = miles." .

gists:has_giver a owl:DatatypeProperty ;
    rdfs:label "has_giver" ;
    rdfs:subPropertyOf gists:has_participant ;
    skos:altLabel "has giver" ;
    skos:definition "Relates something to the participant that provides it." ;
    skos:inScheme gists:core ;
    skos:note "This property is often used in abstract contexts such as agreements, obligations, contracts, etc., whereas gist:comesFromAgent is intended to describe the physical or electronic transfer of something, such as a package or email, from one agent to another. However, there are contexts in which either may be appropriate, such as the giving of a gift." .

gists:has_goal a owl:DatatypeProperty ;
    rdfs:label "has_goal" ;
    skos:altLabel "has goal" ;
    skos:definition "Relates something to the end towards which it directs effort." ;
    skos:inScheme gists:core .

gists:has_incumbent a owl:DatatypeProperty ;
    rdfs:label "has_incumbent" ;
    skos:altLabel "has incumbent" ;
    skos:definition "Relates a position to the thing or person that currently holds that position." ;
    skos:inScheme gists:core ;
    skos:note "To create a temporal view, define a subclass of gist:TemporalRelation for this property (e.g., Incumbency)." .

gists:has_magnitude a owl:ObjectProperty ;
    rdfs:label "has_magnitude" ;
    rdfs:range gists:Magnitude ;
    skos:altLabel "has magnitude" ;
    skos:definition "Relates a thing to a magnitude." ;
    skos:inScheme gists:core .

gists:has_multiplier a owl:DatatypeProperty ;
    rdfs:label "has_multiplier" ;
    skos:altLabel "has multiplier" ;
    skos:definition "Relates a unit of measure to another unit of measure that is a factor, or relates an aspect to another aspect that is a factor." ;
    skos:inScheme gists:core ;
    skos:note "Provides a supplemental method of decomposing a unit of measure or aspect into component factors. Enables dimensional analysis such as miles per hour x hours = miles." .

gists:has_party a owl:DatatypeProperty ;
    rdfs:label "has_party" ;
    rdfs:range [ owl:unionOf ( gists:Organization gists:Person ) ] ;
    rdfs:subPropertyOf gists:has_participant ;
    skos:altLabel "has party" ;
    skos:definition "Relates an event, agreement, or obligation to a participating person or organization." ;
    skos:inScheme gists:core ;
    skos:note "Subproperties may be defined to describe specific parties, such as hasLender and hasBorrower for a loan." .

gists:has_physical_location a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "has_physical_location" ;
    rdfs:range gists:GeoLocation ;
    skos:altLabel "has physical location" ;
    skos:definition "Relates something to its physical location." ;
    skos:inScheme gists:core ;
    skos:note "This property does not distinguish between things whose locations are stable and those whose locations change over time; e.g., a fire hydrant vs. a car." .

gists:has_recipient a owl:DatatypeProperty ;
    rdfs:label "has_recipient" ;
    rdfs:subPropertyOf gists:has_participant ;
    skos:altLabel "has recipient" ;
    skos:definition "Relates something to the participant that receives or is intended to receive it." ;
    skos:inScheme gists:core ;
    skos:note "This property is used in abstract contexts such as agreements, obligations, contracts, etc., whereas gist:goesToAgent is intended to describe the physical or electronic transfer of something, such as a package or email, from one agent to another. However, there are contexts in which either may be appropriate, such as the giving of a gift." .

gists:has_subtrahend a owl:DatatypeProperty ;
    rdfs:label "has_subtrahend" ;
    skos:altLabel "has subtrahend" ;
    skos:definition "Relates an aspect to another aspect that is a subtracted component of it." ;
    skos:inScheme gists:core ;
    skos:note "Commonly used with financial metrics." .

gists:has_unique_broader a owl:DatatypeProperty ;
    rdfs:label "has_unique_broader" ;
    rdfs:subPropertyOf gists:has_broader ;
    skos:altLabel "has unique broader" ;
    skos:definition "Relates a thing to a unique other thing with a broader meaning." ;
    skos:editorialNote "OWL FunctionalProperty (at most one value)" ;
    skos:inScheme gists:core .

gists:has_unique_navigational_parent a owl:DatatypeProperty ;
    rdfs:label "has_unique_navigational_parent" ;
    rdfs:subPropertyOf gists:has_navigational_parent ;
    skos:altLabel "has unique navigational parent" ;
    skos:definition "Relates a subject category to a unique parent category in an informal (e.g., faceted) hierarchy." ;
    skos:editorialNote "OWL FunctionalProperty (at most one value)" ;
    skos:inScheme gists:core .

gists:has_unit_group a owl:ObjectProperty ;
    rdfs:label "has_unit_group" ;
    rdfs:domain gists:Aspect ;
    rdfs:range gists:UnitGroup ;
    skos:altLabel "has unit group" ;
    skos:definition "Relates an aspect to a unit group. The aspect can be measured using any of the members of the unit group." ;
    skos:inScheme gists:core .

gists:has_unit_of_measure a owl:ObjectProperty ;
    rdfs:label "has_unit_of_measure" ;
    rdfs:domain gists:Magnitude ;
    rdfs:range gists:UnitOfMeasure ;
    skos:altLabel "has unit of measure" ;
    skos:definition "Relates a magnitude to its unit of measure." ;
    skos:inScheme gists:core .

gists:id_text a owl:DatatypeProperty ;
    rdfs:label "id_text" ;
    rdfs:range xsd:string ;
    skos:altLabel "id text" ;
    skos:definition "A text string that identifies an individual." ;
    skos:inScheme gists:core ;
    skos:note "A common use case would be for preexisting internal company identifiers.",
        "Often, there will be just one identifying text string. More would be appropriate if the individual had different identifiers, such as employee number and social security number. A good way to model that would be to have functional subproperties of idText, such as departmentNumber.",
        "This property is an alternative to using the property gist:isIdentifiedBy in conjunction with instances of the class gist:ID." .

gists:is_about a owl:DatatypeProperty ;
    rdfs:label "is_about" ;
    rdfs:domain gists:Content ;
    skos:altLabel "is about" ;
    skos:definition "Subject matter of a document." ;
    skos:inScheme gists:core .

gists:is_affected_by a owl:DatatypeProperty ;
    rdfs:label "is_affected_by" ;
    skos:altLabel "is affected by" ;
    skos:definition "Relates an affected thing to the source of the effect." ;
    skos:inScheme gists:core .

gists:is_allocated_by a owl:DatatypeProperty ;
    rdfs:label "is_allocated_by" ;
    rdfs:range [ owl:unionOf ( gists:IntellectualProperty gists:Organization gists:Person ) ] ;
    skos:altLabel "is allocated by" ;
    skos:definition "Relates something to whomever or whatever assigns or distributes it." ;
    skos:inScheme gists:core ;
    skos:note "The allocator may be a person, organization, or automated process." .

gists:is_assignment_of a owl:DatatypeProperty ;
    rdfs:label "is_assignment_of" ;
    rdfs:range [ owl:unionOf ( gists:Person gists:Organization gists:Equipment gists:IntellectualProperty ) ] ;
    skos:altLabel "is assignment of" ;
    skos:definition "Relates an assignment to the resource it assigns." ;
    skos:inScheme gists:core ;
    skos:note "People, organizations, monetary amounts, equipment can all be assigned.",
        "While typically this predicate will be used with assignment subjects, there may be other use cases, and therefore a domain is not specified." .

gists:is_assignment_to a owl:DatatypeProperty ;
    rdfs:label "is_assignment_to" ;
    skos:altLabel "is assignment to" ;
    skos:definition "Relates something (typically an assignment) to the thing the resource is assigned to, such as a project, position, organization, pay rate, or billing rate." ;
    skos:inScheme gists:core ;
    skos:note "While typically this predicate will be used with gist:Assignment subjects, there may be other use cases, and therefore a domain is not specified." .

gists:is_based_on a owl:DatatypeProperty ;
    rdfs:label "is_based_on" ;
    skos:altLabel "is based on" ;
    skos:definition "The object is a foundation for, a starting point for, gave rise to, or justifies the subject." ;
    skos:inScheme gists:core .

gists:is_categorized_by a owl:ObjectProperty ;
    rdfs:label "is_categorized_by" ;
    rdfs:range gists:Category ;
    skos:altLabel "is categorized by" ;
    skos:definition "Relates something to a taxonomy term or other less formally defined classification." ;
    skos:inScheme gists:core .

gists:is_connected_to a owl:DatatypeProperty,
        owl:SymmetricProperty ;
    rdfs:label "is_connected_to" ;
    skos:altLabel "is connected to" ;
    skos:definition "A non-owning, non-causal, non-subordinate (i.e., peer-to-peer) relationship." ;
    skos:inScheme gists:core .

gists:is_direct_part_of a owl:DatatypeProperty ;
    rdfs:label "is_direct_part_of" ;
    rdfs:subPropertyOf gists:is_part_of ;
    skos:altLabel "is direct part of" ;
    skos:definition "The relationship between a part and a whole where the part has independent existence and there are no other parts in between." ;
    skos:inScheme gists:core ;
    skos:note "Because the part has independent existence, there is no cascading delete.",
        "It is safest to use this property when semantic directness is inherent in the relationship, rather than simply expressing a chosen granularity. For example, a spark plug is a direct part of an engine block; there cannot be any intermediate parts. Otherwise, there is a risk of making an isDirectPartOf assertion and then later inserting an intermediate part; this will result in making an asserted triple false even though there was no change in the world. When in doubt, use the transitive version gist:isPartOf." .

gists:is_expressed_in a owl:ObjectProperty ;
    rdfs:label "is_expressed_in" ;
    rdfs:range gists:Language ;
    skos:altLabel "is expressed in" ;
    skos:definition "Relates something to the language it is expressed in." ;
    skos:inScheme gists:core .

gists:is_first_member_of a owl:ObjectProperty ;
    rdfs:label "is_first_member_of" ;
    rdfs:domain gists:OrderedMember ;
    rdfs:range gists:OrderedCollection ;
    rdfs:subPropertyOf gists:is_member_of ;
    skos:altLabel "is first member of" ;
    skos:definition "Relates the first member of an ordered collection to the collection." ;
    skos:editorialNote "OWL FunctionalProperty (at most one value)" ;
    skos:inScheme gists:core ;
    skos:note "Given the Open World Assumption, the absence of a predecessor does not entail that an ordered member is the first member of an ordered collection. This property is used to explicitly indicate the first member. Since ordered collections need not be strictly ordered, there can be more than one first member." .

gists:is_geo_contained_in a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "is_geo_contained_in" ;
    rdfs:domain gists:GeoLocation ;
    rdfs:range gists:GeoLocation ;
    skos:altLabel "is geographically contained in" ;
    skos:definition "Relates one geographic location to another that contains it." ;
    skos:inScheme gists:core .

gists:is_governed_by a owl:DatatypeProperty ;
    rdfs:label "is_governed_by" ;
    skos:altLabel "is governed by" ;
    skos:definition "Relates an entity to another entity that controls, directs, determines or has a guiding influence or authority over it." ;
    skos:inScheme gists:core .

gists:is_identified_by a owl:ObjectProperty ;
    rdfs:label "is_identified_by" ;
    rdfs:range gists:ID ;
    skos:altLabel "is identified by" ;
    skos:definition "Relates something to a content object that uniquely identifies it." ;
    skos:inScheme gists:core ;
    skos:note "This is like a URI: a thing can have more than one ID, but each ID can refer to only one thing. Note that it is possible to have two IDs with the same text that refer to different things." ;
    gists:owl_inverse_functional true .

gists:is_made_up_of a owl:ObjectProperty ;
    rdfs:label "is_made_up_of" ;
    rdfs:range gists:PhysicalSubstance ;
    skos:altLabel "is made up of" ;
    skos:definition "Relates something to a substance that it is made up of." ;
    skos:inScheme gists:core .

gists:is_produced_by a owl:DatatypeProperty ;
    rdfs:label "is_produced_by" ;
    skos:altLabel "is produced by" ;
    skos:definition "Relates something to the thing that created, composed, or brought it into existence." ;
    skos:inScheme gists:core .

gists:is_recognized_by a owl:DatatypeProperty ;
    rdfs:label "is_recognized_by" ;
    rdfs:range [ owl:unionOf ( gists:Organization gists:Person ) ] ;
    skos:altLabel "is recognized by" ;
    skos:definition "Relates something to a party that formally acknowledges its existence, validity, or legality." ;
    skos:inScheme gists:core .

gists:is_recorded_at a owl:DatatypeProperty ;
    rdfs:label "is_recorded_at" ;
    rdfs:subPropertyOf gists:at_date_time ;
    skos:altLabel "is recorded at" ;
    skos:definition "The date that something was posted (which is not necessarily the date it occurred). It must be after the date of occurrence, but could be before or after the planned date." ;
    skos:inScheme gists:core ;
    skos:note "Precision may vary according to context." .

gists:is_rendered_on a owl:DatatypeProperty ;
    rdfs:label "is_rendered_on" ;
    skos:altLabel "is rendered on" ;
    skos:definition "Relates content to the media on which it is rendered." ;
    skos:inScheme gists:core .

gists:is_superseded_by a owl:DatatypeProperty ;
    rdfs:label "is_superseded_by" ;
    skos:altLabel "is superseded by" ;
    skos:definition "Relates a deprecated term to a term that replaces it, which is either an exact (in the case of simple renaming) or approximate (in the case of renaming and some semantic change) semantic match." ;
    skos:inScheme gists:core .

gists:is_triggered_by a owl:DatatypeProperty ;
    rdfs:label "is_triggered_by" ;
    skos:altLabel "is triggered by" ;
    skos:definition "Relates a contingency, such as an event or obligation, to the event that gives rise to it." ;
    skos:inScheme gists:core ;
    skos:note "For obligations, this property describes what must happen to trigger the contingent obligation. Other uses include controls, processes, etc." .

gists:is_under_jurisdiction_of a owl:ObjectProperty ;
    rdfs:label "is_under_jurisdiction_of" ;
    rdfs:range gists:GovernmentOrganization ;
    skos:altLabel "is under jurisdiction of" ;
    skos:definition "Relates a law, contract, etc., to the system of law or government which has the power, right, or authority to interpret and apply it." ;
    skos:inScheme gists:core .

gists:latitude a owl:DatatypeProperty ;
    rdfs:label "latitude" ;
    rdfs:domain gists:GeoPoint ;
    rdfs:range xsd:float ;
    skos:altLabel "latitude" ;
    skos:definition "Degrees above or below the equator." ;
    skos:inScheme gists:core .

gists:license a owl:DatatypeProperty ;
    rdfs:label "license" ;
    skos:altLabel "license" ;
    skos:definition "Relates something to its conditions of use." ;
    skos:inScheme gists:core ;
    skos:note "Could refer to a license object by URI or name or could consist of the license text itself." .

gists:links_from a owl:ObjectProperty ;
    rdfs:label "links_from" ;
    rdfs:range gists:NetworkNode ;
    rdfs:subPropertyOf gists:links ;
    skos:altLabel "links from" ;
    skos:definition "Relates a network link to its origin network node. Unlike the superproperty, this represents a directed connection." ;
    skos:inScheme gists:core .

gists:links_to a owl:ObjectProperty ;
    rdfs:label "links_to" ;
    rdfs:range gists:NetworkNode ;
    rdfs:subPropertyOf gists:links ;
    skos:altLabel "links to" ;
    skos:definition "Relates a network link to its destination network node. Unlike the superproperty, this represents a directed connection." ;
    skos:inScheme gists:core .

gists:longitude a owl:DatatypeProperty ;
    rdfs:label "longitude" ;
    rdfs:domain gists:GeoPoint ;
    rdfs:range xsd:float ;
    skos:altLabel "longitude" ;
    skos:definition "Degrees from the prime meridian." ;
    skos:inScheme gists:core .

gists:numeric_value a owl:DatatypeProperty ;
    rdfs:label "numeric_value" ;
    skos:altLabel "numeric value" ;
    skos:definition "The actual value of a magnitude." ;
    skos:inScheme gists:core .

gists:occurs_in a owl:DatatypeProperty ;
    rdfs:label "occurs_in" ;
    skos:altLabel "occurs in" ;
    skos:definition "Relates something, such as an event, to the geographic location where it did, does, or will happen." ;
    skos:inScheme gists:core .

gists:offers_to_provide a owl:DatatypeProperty ;
    rdfs:label "offers_to_provide" ;
    skos:altLabel "offers to provide" ;
    skos:definition "Relates an offer to the thing being made available for exchange." ;
    skos:inScheme gists:core ;
    skos:note "This will most often be a good or service, but could be an amount of money, e.g., for currency exchange." .

gists:offers_to_receive a owl:DatatypeProperty ;
    rdfs:label "offers_to_receive" ;
    skos:altLabel "offers to receive" ;
    skos:definition "Relates an offer to the thing expected in return for the offered item." ;
    skos:inScheme gists:core ;
    skos:note "This will most often be an amount of money, but could be anything of value, as in swaps." .

gists:owns a owl:DatatypeProperty ;
    rdfs:label "owns" ;
    rdfs:domain gists:Organization ;
    rdfs:range [ owl:unionOf ( gists:Organization gists:Person ) ] ;
    skos:altLabel "owns" ;
    skos:definition "Relates a party to something that it possesses and controls." ;
    skos:inScheme gists:core ;
    skos:note "The ultimate form of ownership is the right to destroy.",
        "There is a long list of potential range classes." .

gists:planned_end_date a owl:DatatypeProperty ;
    rdfs:label "planned_end_date" ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf gists:planned_end_date_time ;
    skos:altLabel "planned end date" ;
    skos:definition "The date that something is or was planned to end, with precision of one day." ;
    skos:inScheme gists:core ;
    skos:note "Used for anything with a planned end date, such as when a lease will expire, when an offer is no longer available, etc. Typically a planned date is in the future when first captured, but when tasks run late, we leave the plan where it was and compare it to the actual. Recommended usage is to zero out the hours through microseconds to avoid spurious precision." .

gists:planned_end_minute a owl:DatatypeProperty ;
    rdfs:label "planned_end_minute" ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf gists:planned_end_date_time ;
    skos:altLabel "planned end minute" ;
    skos:definition "The date and time that something is or was planned to end, with precision of one minute." ;
    skos:inScheme gists:core ;
    skos:note "Used for things like meetings and time card entries, where the hour and minute are important. Recommended usage is to zero out the seconds and microseconds to avoid spurious precision.Typically a planned date is in the future when first captured, but when tasks run late, we leave the plan where it was and compare it to the actual." .

gists:planned_end_year a owl:DatatypeProperty ;
    rdfs:label "planned_end_year" ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf gists:planned_end_date_time ;
    skos:altLabel "planned end year" ;
    skos:definition "The date that something is or was planned to end, with precision of one year." ;
    skos:inScheme gists:core ;
    skos:note "Used for anything with a planned end date where precision of one year is sufficient. Typically a planned date is in the future when first captured, but when tasks run late, we leave the plan where it was and compare it to the actual. Recommended usage is to zero out the hours through microseconds to avoid spurious precision. Note that it is not valid to zero out months and days, so arbitrary values must be included." .

gists:planned_start_date a owl:DatatypeProperty ;
    rdfs:label "planned_start_date" ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf gists:planned_start_date_time ;
    skos:altLabel "planned start date" ;
    skos:definition "The date that something is or was planned to start, with precision of one day." ;
    skos:inScheme gists:core ;
    skos:note "Used for anything with a planned start date, such as when a lease will start, when a configuration becomes available, etc. Typically a planned date is in the future when first captured, but when tasks run late, we leave the plan where it was and compare it to the actual. Recommended usage is to zero out the hours through microseconds to avoid spurious precision." .

gists:planned_start_minute a owl:DatatypeProperty ;
    rdfs:label "planned_start_minute" ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf gists:planned_start_date_time ;
    skos:altLabel "planned start minute" ;
    skos:definition "The date and time that something is or was planned to start, with precision of one minute." ;
    skos:inScheme gists:core ;
    skos:note "Used for things like meetings and time card entries, where the hour and minute are important. Typically a planned date is in the future when first captured, but when tasks run late, we leave the plan where it was and compare it to the actual. Recommended usage is to zero out the seconds and microseconds to avoid spurious precision." .

gists:planned_start_year a owl:DatatypeProperty ;
    rdfs:label "planned_start_year" ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf gists:planned_start_date_time ;
    skos:altLabel "planned start year" ;
    skos:definition "The date that something is or was planned to start, with precision of one year." ;
    skos:inScheme gists:core ;
    skos:note "Used for anything with a planned start date where precision of one year is sufficient. Typically a planned date is in the future when first captured, but when tasks run late, we leave the plan where it was and compare it to the actual. Recommended usage is to zero out the hours through microseconds to avoid spurious precision. Note that it is not valid to zero out months and days, so arbitrary values must be included." .

gists:precedes_directly a owl:DatatypeProperty ;
    rdfs:label "precedes_directly" ;
    rdfs:subPropertyOf gists:precedes ;
    skos:altLabel "precedes directly" ;
    skos:definition "A generic ordering relation indicating that the subject comes immediately before the object." ;
    skos:inScheme gists:core ;
    skos:note "If two items in an ordered collection share the same position, they both directly precede the following element.",
        "It is safest to use this property only when the directness has a semantic correspondence with the world. Only break a direct link by inserting an intermediate item when that change corresponds to a change in the world.",
        "Typically this predicate would be used asymmetrically and irreflexively, but the ontology does not formalize this." .

gists:prevents a owl:ObjectProperty ;
    rdfs:label "prevents" ;
    rdfs:domain gists:Intention ;
    rdfs:range gists:Behavior ;
    skos:altLabel "prevents" ;
    skos:definition "Relates an intention to behavior that it prohibits." ;
    skos:editorialNote "See guidance on removing this term in the next major release at https://github.com/semanticarts/gist/issues/1380#issuecomment-3617257248" ;
    skos:exactMatch gist:prohibits ;
    skos:inScheme gists:core .

gists:prohibits a owl:ObjectProperty ;
    rdfs:label "prohibits" ;
    rdfs:domain gists:Intention ;
    rdfs:range gists:Behavior ;
    skos:altLabel "prohibits" ;
    skos:definition "Relates an intention to a behavior that it forbids or seeks to prevent." ;
    skos:inScheme gists:core ;
    skos:note "A behavior can be prohibited without being prevented. For example, a speed limit may prohibit driving faster than a stated speed but does not always succeed in preventing drivers from exceeding that speed." .

gists:provides_order_for a owl:DatatypeProperty ;
    rdfs:label "provides_order_for" ;
    rdfs:domain gists:OrderedMember ;
    skos:altLabel "provides order for" ;
    skos:definition "Links a member of an ordered collection to the real-world item it represents in that collection." ;
    skos:editorialNote "OWL FunctionalProperty (at most one value)" ;
    skos:inScheme gists:core .

gists:range_includes a owl:DatatypeProperty ;
    rdfs:label "range_includes" ;
    skos:altLabel "range includes" ;
    skos:definition "Relates a property to a class that is an expected type of its values." ;
    skos:inScheme gists:core ;
    skos:note "There may be multiple rangeIncludes assertions on a single property.",
        "This property is used to guide the ontology user; like all annotation properties, it does not play a role in inference." ;
    skos:relatedMatch skos:scopeNote .

gists:refers_to a owl:DatatypeProperty ;
    rdfs:label "refers_to" ;
    skos:altLabel "refers to" ;
    skos:definition "Relates something to another resource that it points to, indicates, or references." ;
    skos:inScheme gists:core .

gists:requires a owl:DatatypeProperty ;
    rdfs:label "requires" ;
    skos:altLabel "requires" ;
    skos:definition "The subject needs the object or makes it necessary, mandatory, or compulsory." ;
    skos:inScheme gists:core ;
    skos:note """This predicate is defined generally enough to encompass a few different meanings of the English word 'requires':\r
\r
		1. To need something or to make something necessary.\r
		2. To order or demand something, or to order someone to do something, especially because of a rule or law.\r
		3. To make it officially necessary for someone to do something.\r
\r
	Implementations requiring a more specific meaning should define subproperties.""" .

gists:sequence a owl:DatatypeProperty ;
    rdfs:label "sequence" ;
    rdfs:range xsd:integer ;
    skos:altLabel "sequence" ;
    skos:definition "A number that specifies the position of an element within a series." ;
    skos:inScheme gists:core .

gists:symbol a owl:DatatypeProperty ;
    rdfs:label "symbol" ;
    skos:altLabel "symbol" ;
    skos:definition "A symbol for something using only ASCII characters." ;
    skos:inScheme gists:core .

gists:unique_text a owl:DatatypeProperty ;
    rdfs:label "unique_text" ;
    rdfs:subPropertyOf gists:contained_text ;
    skos:altLabel "unique text" ;
    skos:definition "The unique string value of some content object, to be used when there is no possibility of having more than one value." ;
    skos:editorialNote "OWL FunctionalProperty (at most one value)" ;
    skos:inScheme gists:core ;
    skos:note "Note that the uniqueness only goes in one direction: a product catalog number might also be an employee ID." .

gists:Commitment a owl:Class ;
    rdfs:label "Commitment" ;
    rdfs:subClassOf gists:Intention ;
    skos:altLabel "Commitment" ;
    skos:definition "A promise made by a single party to one or more parties to do or not do something or act in a particular way." ;
    skos:editorialNote "OWL equivalentClass: (gist:Intention & (gist:Requirement | gist:Restriction) & ∃hasGiver.(gist:Organization | gist:Person) & ∃isCategorizedBy.gist:DegreeOfCommitment)" ;
    skos:exactMatch gist:Commitment ;
    skos:inScheme gists:core ;
    skos:note "A commitment is unilateral in that it is binding on only one party. This contrasts with gist:Agreement, which consists of commitments that bind two or more parties.",
        "A single commitment may be made to multiple parties at once; it is a single commitment rather than multiple commitments if the same action would fulfill the obligation to all the parties simultaneously. For example, a performer makes a single commitment to hold a performance to all ticket purchasers; by holding the performance, the commitment to all parties is fulfilled in a single action.",
        "The manner in which a commitment is binding may vary. In a business context, we are typically interested in commitments that are legally binding." .

gists:ContingentObligation a owl:Class ;
    rdfs:label "ContingentObligation" ;
    rdfs:subClassOf gists:Commitment ;
    skos:altLabel "Contingent Obligation" ;
    skos:closeMatch <https://w3id.org/lmodel/dpvs/Obligation> ;
    skos:definition "An obligation that is not yet firm. There is some contingent event whose occurrence will cause the obligation to become firm." ;
    skos:editorialNote "OWL equivalentClass: (gist:Commitment & ∃hasGiver.(gist:Organization | gist:Person) & ∃isTriggeredBy.gist:Event)" ;
    skos:exactMatch gist:ContingentObligation ;
    skos:inScheme gists:core ;
    skos:note "A contingent obligation might have a getter counterparty (as in the case of insurance); but it might not (as in the case of an offer)." .

gists:Equipment a owl:Class ;
    rdfs:label "Equipment" ;
    rdfs:subClassOf gists:PhysicalIdentifiableItem ;
    skos:altLabel "Equipment" ;
    skos:definition "Human-made, tangible property other than land or buildings used to perform a task or activity." ;
    skos:editorialNote "OWL equivalentClass: (gist:PhysicalIdentifiableItem & ∃isCategorizedBy.gist:EquipmentType)" ;
    skos:exactMatch gist:Equipment ;
    skos:inScheme gists:core .

gists:FormattedContent a owl:Class ;
    rdfs:label "FormattedContent" ;
    rdfs:subClassOf gists:ContentExpression ;
    skos:altLabel "Formatted Content" ;
    skos:definition "Content encoded in a specific format, but existing as data independent of any particular physical medium." ;
    skos:editorialNote "OWL equivalentClass: (gist:ContentExpression & ∃isExpressedIn.gist:MediaType)" ;
    skos:exactMatch gist:FormattedContent ;
    skos:inScheme gists:core ;
    skos:note "Each instance of formatted content is a distinct formatting of some Content. Thus, a PDF-formatted version and an HTML-formatted version of the same content are separate instances of formatted content." .

gists:GeoRegion a owl:Class ;
    rdfs:label "GeoRegion" ;
    rdfs:subClassOf gists:GeoLocation ;
    skos:altLabel "Geographic Region" ;
    skos:broadMatch <https://w3id.org/lmodel/dpvs/PersonalSpace> ;
    skos:definition "A bounded region (or set of regions) on the surface of the Earth." ;
    skos:editorialNote "OWL subClassOf restrictions: (gist:GeoLocation & ∃hasMagnitude.∃hasAspect=_Aspect_area)" ;
    skos:exactMatch gist:GeoRegion ;
    skos:inScheme gists:core ;
    skos:note "A geographic region could be non-contiguous; e.g., the region governed by the US federal government is the contiguous area of the lower 48 states plus Alaska, Hawaii, and overseas territories. Child classes in lower ontologies can make this distinction." .

gists:GovernedGeoRegion a owl:Class ;
    rdfs:label "GovernedGeoRegion" ;
    rdfs:subClassOf gists:GeoRegion ;
    skos:altLabel "Governed Geographic Region" ;
    skos:definition "A geographic region governed by at least one government organization." ;
    skos:editorialNote "OWL equivalentClass: (gist:GeoRegion & ∃isGovernedBy.gist:GovernmentOrganization)" ;
    skos:exactMatch gist:GovernedGeoRegion ;
    skos:inScheme gists:core ;
    skos:note "Geographic regions do not need not be physically contiguous in order to constitute a governed geographic region; e.g., Alaska and Hawaii are part of the region governed by the United States." .

gists:ID a owl:Class ;
    rdfs:label "ID" ;
    rdfs:subClassOf gists:Content ;
    skos:altLabel "ID" ;
    skos:closeMatch <https://w3id.org/lmodel/common_domain_model/AssignedIdentifier>,
        <https://w3id.org/lmodel/common_domain_model/EntityIdentifier>,
        <https://w3id.org/lmodel/common_domain_model/Identifier>,
        <https://w3id.org/lmodel/common_domain_model/PartyIdentifier>,
        <https://w3id.org/lmodel/common_domain_model/PersonIdentifier> ;
    skos:definition "Content that is used to uniquely identify something or someone." ;
    skos:editorialNote "OWL equivalentClass: (gist:Content & ∃isAllocatedBy.(gist:IntellectualProperty | gist:Organization | gist:Person) & ∃uniqueText.<http://www.w3.org/2001/XMLSchema#string>)" ;
    skos:exactMatch gist:ID ;
    skos:inScheme gists:core ;
    skos:note "Used in conjunction with gist:isIdentifiedBy." .

gists:Landmark a owl:Class ;
    rdfs:label "Landmark" ;
    rdfs:subClassOf gists:PhysicalIdentifiableItem ;
    skos:altLabel "Landmark" ;
    skos:definition "Something permanently attached to the Earth." ;
    skos:editorialNote "OWL subClassOf restrictions: ∃hasPhysicalLocation.(gist:GeoRegion | gist:GeoVolume)",
        "See guidance on removing the term in the next major release at https://github.com/semanticarts/gist/issues/947#issuecomment-1679566885." ;
    skos:exactMatch gist:Landmark ;
    skos:inScheme gists:core .

gists:Language a owl:Class ;
    rdfs:label "Language" ;
    rdfs:subClassOf gists:GistThing ;
    skos:altLabel "Language" ;
    skos:definition "A recognized, organized set of symbols and grammar." ;
    skos:exactMatch gist:Language ;
    skos:inScheme gists:core .

gists:PhysicalSubstance a owl:Class ;
    rdfs:label "PhysicalSubstance" ;
    rdfs:subClassOf gists:GistThing ;
    skos:altLabel "Physical Substance" ;
    skos:definition "An undifferentiated amount of physical material which, when subdivided, results in each part being indistinguishable in nature from the whole and from every other part." ;
    skos:editorialNote "OWL subClassOf restrictions: ∃hasMagnitude.∃hasAspect=_Aspect_volume; ∃hasMagnitude.∃hasAspect=_Aspect_mass" ;
    skos:exactMatch gist:PhysicalSubstance ;
    skos:inScheme gists:core ;
    skos:note "An instance of this class has weight and takes up space. We mean the physical gold in a ring, not the concept of gold that shows up in the periodic table. The latter would be an instance of gist:KnowledgeConcept.",
        "This concept generally corresponds to mass nouns in English. By contrast, instances of gist:PhysicalIdentifiableItem, such as a computer, book, or car, are count nouns. Physical identifiable items are made up of physical substances; e.g., a cake is made up of butter, flour, and sugar; a ring is made of gold. If you divide a physical substance such as an amount of water into parts, you have different amounts of water otherwise indistinguishable from one another; if you divide a physical identifiable item such as a computer into parts, each part will be distinguishable from the original whole." .

gists:ScheduledEvent a owl:Class ;
    rdfs:label "ScheduledEvent" ;
    rdfs:subClassOf gists:Event ;
    skos:altLabel "Scheduled Event" ;
    skos:definition "An event with a planned start datetime." ;
    skos:editorialNote "OWL equivalentClass: (gist:Event & ∃plannedStartDateTime.<http://www.w3.org/2001/XMLSchema#dateTime>)" ;
    skos:exactMatch gist:ScheduledEvent ;
    skos:inScheme gists:core ;
    skos:note "If the event already started, but has not yet ended, it is a contemporary event with an actual start datetime. If the event is over, it is a historical event having an actual end datetime. The event always retains its planned start datetime, and thus continues to be a scheduled event." ;
    skos:relatedMatch <https://w3id.org/lmodel/common_domain_model/Schedule> .

gists:Task a owl:Class ;
    rdfs:label "Task" ;
    rdfs:subClassOf gists:Event ;
    skos:altLabel "Task" ;
    skos:closeMatch <https://w3id.org/lmodel/iso22989/Task> ;
    skos:definition "An activity or piece of work that is either proposed, planned, scheduled, underway, or completed." ;
    skos:editorialNote "OWL equivalentClass: (gist:Event & ∃hasGoal.gist:Intention)" ;
    skos:exactMatch gist:Task ;
    skos:inScheme gists:core ;
    skos:note "Something that could potentially be executed, which is merely described but not proposed in any specific way, such as a business process for onboarding a new employee, or the steps in a recipe for making polyethylene from ethylene, is not a task but rather a task template.",
        "This term is broader than the English word 'task,' which implies assignment, responsibility, or duty. In ordinary English going to a concert has a goal but is (generally) done for pleasure rather than out of obligation, and would not be considered a task, while according to the gist definition it is a task. The expansion of meaning is deliberate, so that anything that has a goal and can be specified by a task template is a task.",
        "Use the property gist:isBasedOn to link a task back to the task template." ;
    skos:relatedMatch <https://w3id.org/lmodel/common_domain_model/Workflow> .

gists:Template a owl:Class ;
    rdfs:label "Template" ;
    rdfs:subClassOf gists:GistThing ;
    skos:altLabel "Template" ;
    skos:definition "Something used to make objects in its own image." ;
    skos:exactMatch gist:Template ;
    skos:inScheme gists:core ;
    skos:note "Use gist:isBasedOn to link the object made from the template back to the template." .

gists:TemporalRelation a owl:Class ;
    rdfs:label "TemporalRelation" ;
    rdfs:subClassOf gists:GistThing ;
    skos:altLabel "Temporal Relation" ;
    skos:definition "A relationship existing for a period of time." ;
    skos:editorialNote "OWL subClassOf restrictions: =1startDateTime; ≥2hasParticipant" ;
    skos:exactMatch gist:TemporalRelation ;
    skos:inScheme gists:core ;
    skos:note "A temporal relation must have a minimum of two participants. For example, both the employer and the employee are participants in a temporal relation representing a period of employment. Note that 'participant' does not imply agency; a non-sentient being can participate in a temporal relation. For example, both a person and a house could be participants in a hypothetical relation 'lives at.'" .

gists:actual_end_date a owl:DatatypeProperty ;
    rdfs:label "actual_end_date" ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf gists:actual_end_date_time ;
    skos:altLabel "actual end date" ;
    skos:definition "The actual date that something ended, with precision of one day." ;
    skos:inScheme gists:core ;
    skos:note "Used for things where the precision of a date is sufficient, such as most projects, tasks, and the like. Recommended usage is to zero out the hours through microseconds to avoid spurious precision." .

gists:has_navigational_parent a owl:DatatypeProperty ;
    rdfs:label "has_navigational_parent" ;
    skos:altLabel "has navigational parent" ;
    skos:definition "Relates a child category to a parent category in an informal (e.g., faceted) hierarchy." ;
    skos:inScheme gists:core .

gists:is_member_of a owl:DatatypeProperty ;
    rdfs:label "is_member_of" ;
    rdfs:range [ owl:unionOf ( gists:Organization gists:Collection ) ] ;
    skos:altLabel "is member of" ;
    skos:definition "Relates a member individual to the thing, such as a collection or organization, that it is a member of." ;
    skos:inScheme gists:core .

gists:is_part_of a owl:DatatypeProperty,
        owl:TransitiveProperty ;
    rdfs:label "is_part_of" ;
    skos:altLabel "is part of" ;
    skos:definition "The relationship between a part and a whole where the part has independent existence." ;
    skos:inScheme gists:core ;
    skos:note "Because the part has independent existence, there is no cascading delete.",
        "The transitive version of gist:isDirectPartOf." .

gists:precedes a owl:DatatypeProperty,
        owl:TransitiveProperty ;
    rdfs:label "precedes" ;
    skos:altLabel "precedes" ;
    skos:definition "A generic ordering relation indicating that the subject comes before the object." ;
    skos:inScheme gists:core ;
    skos:note "The less-than symbol is often used to represent this relation.",
        "This is the transitive version of gist:precedesDirectly.",
        "Typically this predicate would be used asymmetrically and irreflexively, but the ontology does not formalize this." .

gists:Agreement a owl:Class ;
    rdfs:label "Agreement" ;
    rdfs:subClassOf gists:Intention ;
    skos:altLabel "Agreement" ;
    skos:broadMatch <https://w3id.org/lmodel/common_domain_model/MasterAgreement>,
        <https://w3id.org/lmodel/dpvs/DataProcessingAgreement> ;
    skos:definition "A mutually understood arrangement in which two or more parties make commitments to one another." ;
    skos:editorialNote "OWL equivalentClass: (gist:Intention & ∃hasParty.(gist:Organization | gist:Person) & ≥2^isDirectPartOf.gist:Commitment)" ;
    skos:exactMatch <https://w3id.org/lmodel/common_domain_model/Agreement>,
        gist:Agreement ;
    skos:inScheme gists:core ;
    skos:note "While an agreement has two or more parties, and contains commitments which bind those parties, it will not always be necessary to instantiate each individual commitment." .

gists:Aspect a owl:Class ;
    rdfs:label "Aspect" ;
    rdfs:subClassOf gists:GistThing ;
    skos:altLabel "Aspect" ;
    skos:definition "A measurable characteristic." ;
    skos:exactMatch gist:Aspect ;
    skos:inScheme gists:core ;
    skos:note "Depending on implementation, every aspect should be related to a unit group either directly or through a broader aspect. For example, angle of incidence could be related to the broader concept of angle, which in turn is related to a unit group, or it could be related directly to the unit group without the hierarchical relationship.",
        "Rule of thumb: use the least specific aspect that serves the intended purpose, increasing specificity only when required (e.g., to distinguish between two magnitudes attached to the same object)." .

gists:Behavior a owl:Class ;
    rdfs:label "Behavior" ;
    rdfs:subClassOf gists:Category ;
    skos:altLabel "Behavior" ;
    skos:definition "A category indicating the nature of an activity." ;
    skos:exactMatch gist:Behavior ;
    skos:inScheme gists:core .

gists:GeoPoint a owl:Class ;
    rdfs:label "GeoPoint" ;
    rdfs:subClassOf gists:GeoLocation ;
    skos:altLabel "Geographic Point" ;
    skos:definition "An individual point on or above the Earth's surface, identified by latitude, longitude and altitude. Altitude is the distance measured from sea level. If altitude is missing, the point is assumed to be at the Earth's surface. These points are described using decimal latitude/longitude." ;
    skos:editorialNote "OWL equivalentClass: (∃hasMagnitude.∃hasAspect=_Aspect_altitude & ∃latitude.<http://www.w3.org/2001/XMLSchema#double> & ∃longitude.<http://www.w3.org/2001/XMLSchema#double>)" ;
    skos:exactMatch gist:GeoPoint ;
    skos:inScheme gists:core .

gists:OrderedCollection a owl:Class ;
    rdfs:label "OrderedCollection" ;
    rdfs:subClassOf gists:Collection ;
    skos:altLabel "Ordered Collection" ;
    skos:definition "A collection whose members are ordered in some way." ;
    skos:editorialNote "OWL equivalentClass: (gist:Collection & (∃^isFirstMemberOf.gist:OrderedMember | =0^isMemberOf) & ∀^isMemberOf.gist:OrderedMember)" ;
    skos:exactMatch gist:OrderedCollection ;
    skos:inScheme gists:core ;
    skos:note "Includes partially ordered collections as well as collections in which members occupy the same position in a 'tie.' All members of an ordered collection are ordered members." .

gists:OrderedMember a owl:Class ;
    rdfs:label "OrderedMember" ;
    rdfs:subClassOf gists:Component ;
    skos:altLabel "Ordered Member" ;
    skos:definition "A member of an ordered collection serving as a proxy for a real world item, which can appear in different orders in different collections. The ordered member appears in exactly one ordered collection." ;
    skos:editorialNote "OWL equivalentClass: (gist:Component & (∃precedesDirectly.gist:OrderedMember | ∃^precedesDirectly.gist:OrderedMember | ∃sequence.<http://www.w3.org/2001/XMLSchema#integer>) & ∃providesOrderFor.owl:Thing & ∀isMemberOf.gist:OrderedCollection & =1isMemberOf)" ;
    skos:exactMatch gist:OrderedMember ;
    skos:inScheme gists:core ;
    skos:note "An ordered member points to the real world item via the providesOrderFor property. Ordering information is represented either as a number in a sequence, or by preceding or following another ordered member." .

gists:contained_text a owl:DatatypeProperty ;
    rdfs:label "contained_text" ;
    skos:altLabel "contained text" ;
    skos:definition "Relates an entity containing textual information to the string constituting that textual information." ;
    skos:inScheme gists:core ;
    skos:note "If there are multiple strings associated with an entity, it is an implementation decision whether to combine them into a single contained text value or to use multiple contained text assertions." .

gists:end_date_time a owl:DatatypeProperty ;
    rdfs:label "end_date_time" ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf gists:at_date_time ;
    skos:altLabel "end date time" ;
    skos:definition "The date and time that something ends." ;
    skos:inScheme gists:core ;
    skos:note "This property is neutral along two dimensions: precision (e.g., day, second, millisecond) and actual vs. planned. As such, it will generally not be asserted directly except in special cases (e.g., for time intervals).",
        "Values of predicates with different precisions can be compared since they are all formally xsd:datetimes." .

gists:has_broader a owl:DatatypeProperty,
        owl:TransitiveProperty ;
    rdfs:label "has_broader" ;
    skos:altLabel "has broader" ;
    skos:definition "Relates a thing to another thing with a broader meaning." ;
    skos:inScheme gists:core .

gists:links a owl:ObjectProperty ;
    rdfs:label "links" ;
    rdfs:range gists:NetworkNode ;
    skos:altLabel "links" ;
    skos:definition "Relates a network link to a network node that it connects to another node. Used when the connection is undirected or the direction is not known." ;
    skos:inScheme gists:core .

gistd:_Aspect_altitude a owl:Class ;
    rdfs:label "ASPECT_ALTITUDE" ;
    dcterms:title "altitude" ;
    rdfs:subClassOf gists:AspectInstance ;
    skos:definition "The aspect altitude." .

gistd:_Aspect_area a owl:Class ;
    rdfs:label "ASPECT_AREA" ;
    dcterms:title "area" ;
    rdfs:subClassOf gists:AspectInstance ;
    skos:definition "The aspect area." .

gistd:_Aspect_duration a owl:Class ;
    rdfs:label "ASPECT_DURATION" ;
    dcterms:title "duration" ;
    rdfs:subClassOf gists:AspectInstance ;
    skos:definition "The aspect duration." .

gistd:_Aspect_financial_balance a owl:Class ;
    rdfs:label "ASPECT_FINANCIAL_BALANCE" ;
    dcterms:title "balance" ;
    rdfs:subClassOf gists:AspectInstance ;
    skos:definition "The aspect financial balance." .

gistd:_Aspect_mass a owl:Class ;
    rdfs:label "ASPECT_MASS" ;
    dcterms:title "mass" ;
    rdfs:subClassOf gists:AspectInstance ;
    skos:definition "The aspect mass." .

gistd:_Aspect_monetary_value a owl:Class ;
    rdfs:label "ASPECT_MONETARY_VALUE" ;
    dcterms:title "monetary value" ;
    rdfs:subClassOf gists:AspectInstance ;
    skos:definition "The aspect monetary value." .

gistd:_Aspect_probability a owl:Class ;
    rdfs:label "ASPECT_PROBABILITY" ;
    dcterms:title "probability" ;
    rdfs:subClassOf gists:AspectInstance ;
    skos:definition "The aspect probability." .

gistd:_Aspect_volume a owl:Class ;
    rdfs:label "ASPECT_VOLUME" ;
    dcterms:title "volume" ;
    rdfs:subClassOf gists:AspectInstance ;
    skos:definition "The aspect volume." .

gist:_PrefixDeclaration_gist a owl:Class ;
    rdfs:label "PREFIXDECLARATION_GIST" ;
    dcterms:title "gist" ;
    rdfs:subClassOf gists:PrefixDeclarationInstance ;
    skos:definition "Prefix 'gist' for namespace <https://w3id.org/semanticarts/ns/ontology/gist/>." .

gist:_PrefixDeclaration_owl a owl:Class ;
    rdfs:label "PREFIXDECLARATION_OWL" ;
    dcterms:title "owl" ;
    rdfs:subClassOf gists:PrefixDeclarationInstance ;
    skos:definition "Prefix 'owl' for namespace <http://www.w3.org/2002/07/owl#>." .

gist:_PrefixDeclaration_rdf a owl:Class ;
    rdfs:label "PREFIXDECLARATION_RDF" ;
    dcterms:title "rdf" ;
    rdfs:subClassOf gists:PrefixDeclarationInstance ;
    skos:definition "Prefix 'rdf' for namespace <http://www.w3.org/1999/02/22-rdf-syntax-ns#>." .

gist:_PrefixDeclaration_rdfs a owl:Class ;
    rdfs:label "PREFIXDECLARATION_RDFS" ;
    dcterms:title "rdfs" ;
    rdfs:subClassOf gists:PrefixDeclarationInstance ;
    skos:definition "Prefix 'rdfs' for namespace <http://www.w3.org/2000/01/rdf-schema#>." .

gist:_PrefixDeclaration_sh a owl:Class ;
    rdfs:label "PREFIXDECLARATION_SH" ;
    dcterms:title "sh" ;
    rdfs:subClassOf gists:PrefixDeclarationInstance ;
    skos:definition "Prefix 'sh' for namespace <http://www.w3.org/ns/shacl#>." .

gist:_PrefixDeclaration_skos a owl:Class ;
    rdfs:label "PREFIXDECLARATION_SKOS" ;
    dcterms:title "skos" ;
    rdfs:subClassOf gists:PrefixDeclarationInstance ;
    skos:definition "Prefix 'skos' for namespace <http://www.w3.org/2004/02/skos/core#>." .

gist:_PrefixDeclaration_xsd a owl:Class ;
    rdfs:label "PREFIXDECLARATION_XSD" ;
    dcterms:title "xsd" ;
    rdfs:subClassOf gists:PrefixDeclarationInstance ;
    skos:definition "Prefix 'xsd' for namespace <http://www.w3.org/2001/XMLSchema#>." .

media_app:json a owl:Class ;
    rdfs:label "JSON" ;
    dcterms:title "JSON" ;
    rdfs:subClassOf gists:MediaTypeInstance .

<https://www.iana.org/assignments/media-types/application/ld+json> a owl:Class ;
    rdfs:label "LD_PLUS_JSON" ;
    dcterms:title "JSON-LD" ;
    rdfs:subClassOf gists:MediaTypeInstance .

media_app:n-quads a owl:Class ;
    rdfs:label "N_QUADS" ;
    dcterms:title "N-Quads" ;
    rdfs:subClassOf gists:MediaTypeInstance .

media_app:n-triples a owl:Class ;
    rdfs:label "N_TRIPLES" ;
    dcterms:title "N-Triples" ;
    rdfs:subClassOf gists:MediaTypeInstance .

<https://www.iana.org/assignments/media-types/application/rdf+xml> a owl:Class ;
    rdfs:label "RDF_PLUS_XML" ;
    dcterms:title "RDF/XML" ;
    rdfs:subClassOf gists:MediaTypeInstance .

<https://www.iana.org/assignments/media-types/application/sparql-results+json> a owl:Class ;
    rdfs:label "SPARQL_RESULTS_PLUS_JSON" ;
    dcterms:title "SPARQL 1.1 Query Results JSON" ;
    rdfs:subClassOf gists:MediaTypeInstance .

<https://www.iana.org/assignments/media-types/application/sparql-results+xml> a owl:Class ;
    rdfs:label "SPARQL_RESULTS_PLUS_XML" ;
    dcterms:title "SPARQL 1.1 Query Results XML" ;
    rdfs:subClassOf gists:MediaTypeInstance .

media_app:trig a owl:Class ;
    rdfs:label "TRIG" ;
    dcterms:title "TriG" ;
    rdfs:subClassOf gists:MediaTypeInstance .

media_img:jpg a owl:Class ;
    rdfs:label "JPG" ;
    dcterms:title "JPG" ;
    rdfs:subClassOf gists:MediaTypeInstance .

media_img:png a owl:Class ;
    rdfs:label "PNG" ;
    dcterms:title "PNG" ;
    rdfs:subClassOf gists:MediaTypeInstance .

media_txt:csv a owl:Class ;
    rdfs:label "CSV" ;
    dcterms:title "CSV" ;
    rdfs:subClassOf gists:MediaTypeInstance .

media_txt:html a owl:Class ;
    rdfs:label "HTML" ;
    dcterms:title "HTML" ;
    rdfs:subClassOf gists:MediaTypeInstance .

media_txt:plain a owl:Class ;
    rdfs:label "PLAIN" ;
    dcterms:title "Plain Text" ;
    rdfs:subClassOf gists:MediaTypeInstance .

media_txt:turtle a owl:Class ;
    rdfs:label "TURTLE" ;
    dcterms:title "Turtle" ;
    rdfs:subClassOf gists:MediaTypeInstance .

gists:CatalogItem a owl:Class ;
    rdfs:label "CatalogItem" ;
    rdfs:subClassOf gists:Specification ;
    skos:altLabel "Catalog Item" ;
    skos:definition "A description of a product or service to be delivered, given in a sufficient level of detail that a receiver could determine whether delivery constituted discharge of the obligation to deliver." ;
    skos:exactMatch gist:CatalogItem ;
    skos:inScheme gists:core ;
    skos:note "In short, an unambiguous characterization of what it is that a potential buyer is paying for." .

gists:Component a owl:Class ;
    rdfs:label "Component" ;
    rdfs:subClassOf gists:GistThing ;
    skos:altLabel "Component" ;
    skos:definition "Something that, while having an independent existence, is inherently part of or designed to be part of a larger entity, such as a system or network." ;
    skos:exactMatch gist:Component ;
    skos:inScheme gists:core ;
    skos:note "A component may be designed or intended as part of a whole without actually being so; e.g., a car steering wheel that is not installed in any car.",
        "Many things are in a trivial sense a part of a larger thing, but are not considered components because they are not inherently part of that larger thing. For example, while a book may be part of a library (a collection of books), it is not inherently so, and thus is not a component. A playing card, on the other hand, could be considered a component in (member of) a deck of cards. This may be use case-dependent; e.g., car parts might be modeled as components in an automobile manufacturing context but not in a retail auto parts store.",
        "Physical substances, such as ingredients in a cake batter, do not meet the independent existence criterion, so are not components.",
        "This class is not disjoint with gist:Composite, because a component may itself break down into smaller components.",
        "This is an abstract class that is not directly instantiated. Users will define subclasses that are meaningful to their domain of interest." .

gists:Composite a owl:Class ;
    rdfs:label "Composite" ;
    rdfs:subClassOf gists:GistThing ;
    skos:altLabel "Composite" ;
    skos:definition "Something which is made up of various parts or elements that are independently identifiable." ;
    skos:exactMatch gist:Composite ;
    skos:inScheme gists:core ;
    skos:note "Some composites, like systems, networks, and ordered collections, have internal organization, while others, such as unordered collections, typically do not.",
        "This class is not disjoint with gist:Component, because a composite can itself be a component of a larger composite.",
        "This is an abstract class that will not be directly instantiated." .

gists:ContentExpression a owl:Class ;
    rdfs:label "ContentExpression" ;
    rdfs:subClassOf gists:Content ;
    skos:altLabel "Content Expression" ;
    skos:definition "Content reduced to text, audio, etc." ;
    skos:editorialNote "OWL subClassOf restrictions: ∃isCategorizedBy.gist:GeneralMediaType" ;
    skos:exactMatch gist:ContentExpression ;
    skos:inScheme gists:core ;
    skos:note "If it contains text (written or spoken), it will be expressed in a language.",
        "While the content expression is less abstract than a 'Work,' it is more abstract than the specific physical items that render the expression. For example, any physical or electronic book with ISBN-13 978-1953649805 is associated with the same content expression." .

gists:GovernmentOrganization a owl:Class ;
    rdfs:label "GovernmentOrganization" ;
    rdfs:subClassOf gists:Organization ;
    skos:altLabel "Government Organization" ;
    skos:broadMatch <https://w3id.org/lmodel/common_domain_model/LegalEntity> ;
    skos:definition "An independent organization exercising political and/or regulatory authority over a political unit, people, geographical region, etc., as well as performing certain functions for this unit or body." ;
    skos:exactMatch gist:GovernmentOrganization ;
    skos:inScheme gists:core ;
    skos:note "Includes administrative, regulatory, and enforcement organizations created or sanctioned by country or sub-country governments." .

gists:IntellectualProperty a owl:Class ;
    rdfs:label "IntellectualProperty" ;
    rdfs:subClassOf gists:GistThing ;
    skos:altLabel "Intellectual Property" ;
    skos:broadMatch <https://w3id.org/lmodel/dpvs/IntellectualPropertyData> ;
    skos:definition "An intangible work, invention, or concept, independent of its being expressed in text, audio, video, image, or live performance. IP can also be tacit knowledge, know-how, or skill." ;
    skos:exactMatch gist:IntellectualProperty ;
    skos:inScheme gists:core ;
    skos:note "For literature this could be called the 'Work,' except that 'work' is a highly overloaded term (expenditure of energy, resource consumption, art). Often the first expression precedes our recognition of the IP, but subsequent expressions are known to be derivatives of the IP, even if they are expression-to-expression translations (or copies).",
        "This concept includes works that are out of copyright or were never formally registered; the defining feature is not that it is legally protected but that it is an intangible creation of the human mind." .

gists:LivingThing a owl:Class ;
    rdfs:label "LivingThing" ;
    rdfs:subClassOf gists:PhysicalIdentifiableItem ;
    skos:altLabel "Living Thing" ;
    skos:definition "Something that is currently, or at some point in time was, alive." ;
    skos:editorialNote "OWL equivalentClass: (gist:PhysicalIdentifiableItem & ∃hasBiologicalParent.gist:LivingThing & =1birthDate)" ;
    skos:exactMatch gist:LivingThing ;
    skos:inScheme gists:core ;
    skos:note "Not all life forms have exactly two parents, so the restriction only specifies a minimum of one." .

gists:NetworkNode a owl:Class ;
    rdfs:label "NetworkNode" ;
    rdfs:subClassOf gists:Component ;
    skos:altLabel "Network Node" ;
    skos:definition "A node in a network." ;
    skos:editorialNote "OWL subClassOf restrictions: ∃isMemberOf.gist:Network" ;
    skos:exactMatch gist:NetworkNode ;
    skos:inScheme gists:core .

gists:PhysicalIdentifiableItem a owl:Class ;
    rdfs:label "PhysicalIdentifiableItem" ;
    rdfs:subClassOf gists:GistThing ;
    skos:altLabel "Physical Identifiable Item" ;
    skos:definition "A discrete physical object which, if subdivided, will result in parts that are distinguishable in nature from the whole and in general also from the other parts." ;
    skos:editorialNote "OWL subClassOf restrictions: ∃hasMagnitude.∃hasAspect=_Aspect_volume; ∃isMadeUpOf.gist:PhysicalSubstance; ∃hasMagnitude.∃hasAspect=_Aspect_mass" ;
    skos:exactMatch gist:PhysicalIdentifiableItem ;
    skos:inScheme gists:core ;
    skos:note "This concept generally corresponds to count nouns in English. By contrast, physical substances, such as an amount of water, flour, or sand, are mass nouns. Physical identifiable items are made up of physical substances; e.g., a cake is made up of butter, flour, and sugar; a statue is made of bronze. If you divide a physical substance such as an amount of water into parts, you have two amounts of water otherwise indistinguishable from one another; if you divide a physical identifiable item such as a computer into parts, each part is different from the whole." .

gists:Specification a owl:Class ;
    rdfs:label "Specification" ;
    rdfs:subClassOf gists:Intention ;
    skos:altLabel "Specification" ;
    skos:definition "The set of characteristics and constraints on their values that specify what it means to be a particular type of thing, such as a material, product, service or event. A specification is sufficiently precise to allow evaluating conformance to the specification." ;
    skos:exactMatch gist:Specification ;
    skos:inScheme gists:core ;
    skos:note "Although a characterization of how to do something is often called a specification, the intended meaning here is limited to specifying what something is. The focus is on the what, not the how. Use gist:TaskTemplate for specifying the how, such as a plan or process specification. Use gist:conformsTo to assert that something conforms to a specification. To represent a definition of a particular type of thing that is not sufficiently precise to be a gist:Specification, consider using gist:KnowledgeConcept." ;
    skos:relatedMatch <https://w3id.org/lmodel/common_domain_model/EligibleCollateralCriteria> .

gists:at_date_time a owl:DatatypeProperty ;
    rdfs:label "at_date_time" ;
    rdfs:range xsd:dateTime ;
    skos:altLabel "at date time" ;
    skos:definition "The date and time at which something did or will occur, with variants for precision, start and end, and actual vs. planned." ;
    skos:inScheme gists:core ;
    skos:note """This is the top level property for asserting time, and is not expected to be asserted directly.\r
\r
The subproperties allow the ontologist to do three things:\r
1) Distinguish start and end times.\r
2) Indicate whether a time is planned or actual. This is useful for everything from project management to calendar appointments and the like. It is also useful for date effectivities; i.e., something valid up to a planned date).\r
3) Distinguish varying levels of precision; sort of a simple version of the Allen functions.\r
\r
All datetimes are of the same format: '2021-06-01T08:03:27.12324-6:00'^^xsd:dateTime. This is compatible with and a subset of ISO 8601.\r
\r
Time zone offset, such as -6:00 (of which there are a few dozen) is recognized in the date itself, as shown. The actual time zone standard (of which there are 131) may optionally be attached to the event or other object itself.\r
\r
There will be many historical dates that do not have a time zone offset (e.g., Lincoln's birthday, as well as about 75% of all legacy systems), and in that case the offset can be omitted.\r
\r
The conventions for precision that are repeated in each property name are as follows:\r
	- *DateTime is an abstraction over the various precisions of its subproperties.\r
	- *Date refers to a calendar date (e.g., birthdays and invoice dates) and is assumed to have precision of one day. Time zone offset is allowed.\r
	- *Minute refers to clock time; e.g., a meeting will start at 9:15 with a timezone offset. Precision is assumed to have precision of one minute.\r
	- *Microsecond refers to system time, and it will be as precise as the system can supply; typically at least milliseconds, sometime microseconds.\r
""" .

gists:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    skos:altLabel "description" ;
    skos:definition "A statement about someone or something's attributes or characteristics." ;
    skos:inScheme gists:core ;
    skos:note "This property is used to describe instance data which is not part of the ontology. A definition and a description have different semantics. Use skos:definition for a statement of the meaning of a thing and gist:description to describe a thing's attributes, characteristics, or features." .

gists:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    skos:altLabel "name" ;
    skos:definition "Relates an individual to (one of) its name(s)." ;
    skos:inScheme gists:core .

gists:planned_end_date_time a owl:DatatypeProperty ;
    rdfs:label "planned_end_date_time" ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf gists:end_date_time ;
    skos:altLabel "planned end date time" ;
    skos:definition "The date that something is or was planned to end, with no implied precision." ;
    skos:inScheme gists:core ;
    skos:note "This is an abstraction over the various precisions of planned end time, and is not expected to be asserted directly. Values of predicates with different precisions can be compared since they are all formally xsd:datetimes.",
        "This property, unlike gist:actualEndDateTime, does not have a subproperty for microsecond precision, because planned times typically are not expressed at that level of granularity. Typically a planned date is in the future when first captured, but when tasks run late, we leave the plan where it was and compare it to the actual." .

gists:planned_start_date_time a owl:DatatypeProperty ;
    rdfs:label "planned_start_date_time" ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf gists:start_date_time ;
    skos:altLabel "planned start date time" ;
    skos:definition "The date and time that something is or was planned to start, with no implied precision." ;
    skos:inScheme gists:core ;
    skos:note "This is an abstraction over the various precisions of planned start time, and is not expected to be asserted directly. Values of predicates with different precisions can be compared since they are all formally xsd:datetimes.",
        "This property, unlike gist:actualStartDateTime, does not have a subproperty for microsecond precision, because planned times typically are not expressed at that level of granularity. Typically a planned date is in the future when first captured, but when tasks run late, we leave the plan where it was and compare it to the actual." .

gists:start_date_time a owl:DatatypeProperty ;
    rdfs:label "start_date_time" ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf gists:at_date_time ;
    skos:altLabel "start date time" ;
    skos:definition "The date and time that something starts." ;
    skos:inScheme gists:core ;
    skos:note "This property is neutral along two dimensions: precision (e.g., day, second, millisecond) and actual vs. planned. As such, it will generally not be asserted directly except in special cases (e.g., for time intervals).",
        "Values of predicates with different precisions can be compared since they are all formally xsd:datetimes." .

gists:Collection a owl:Class ;
    rdfs:label "Collection" ;
    rdfs:subClassOf gists:Composite ;
    skos:altLabel "Collection" ;
    skos:definition "A grouping of things." ;
    skos:exactMatch gist:Collection ;
    skos:inScheme gists:core ;
    skos:note "Individuals are placed in the collection using the gist:isMemberOf property. Collections typically are created because the members are functionally connected in some way. This definition allows a collection to have zero members." .

gists:Content a owl:Class ;
    rdfs:label "Content" ;
    rdfs:subClassOf gists:GistThing ;
    skos:altLabel "Content" ;
    skos:definition "Information available in some medium." ;
    skos:exactMatch gist:Content ;
    skos:inScheme gists:core ;
    skos:note "Categories are not content until they are written down.",
        "This class includes both abstract content and its expression, but it must have at least one expression in order to be content. For example, the idea a writer has for a book is not content until it is expressed in some form, but a single content object may have multiple expressions - e.g., the particular print and audio editions." .

gists:Magnitude a owl:Class ;
    rdfs:label "Magnitude" ;
    rdfs:subClassOf gists:GistThing ;
    skos:altLabel "Magnitude" ;
    skos:closeMatch <https://w3id.org/lmodel/common_domain_model/Cash>,
        <https://w3id.org/lmodel/common_domain_model/Measure>,
        <https://w3id.org/lmodel/common_domain_model/Money>,
        <https://w3id.org/lmodel/common_domain_model/Quantity> ;
    skos:definition "The amount of a measurable characteristic (aspect)." ;
    skos:editorialNote "OWL equivalentClass: (∃hasAspect.gist:Aspect & ∃hasUnitOfMeasure.gist:UnitOfMeasure & ∃numericValue.<http://www.w3.org/2000/01/rdf-schema#Literal>)" ;
    skos:exactMatch gist:Magnitude ;
    skos:inScheme gists:core ;
    skos:note "An accuracy can be assigned to a magnitude using the property has accuracy." ;
    skos:relatedMatch <https://w3id.org/lmodel/common_domain_model/Price> .

gists:actual_end_date_time a owl:DatatypeProperty ;
    rdfs:label "actual_end_date_time" ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf gists:end_date_time ;
    skos:altLabel "actual end date time" ;
    skos:definition "The actual date and time that something ended, with no implied precision." ;
    skos:inScheme gists:core ;
    skos:note "This is an abstraction over the various precisions of actual end time, and is not expected to be asserted directly. Values of predicates with different precisions can be compared since they are all formally xsd:datetimes." .

gists:actual_start_date_time a owl:DatatypeProperty ;
    rdfs:label "actual_start_date_time" ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf gists:start_date_time ;
    skos:altLabel "actual start date time" ;
    skos:definition "The actual date and time that something started, with no implied precision." ;
    skos:inScheme gists:core ;
    skos:note "This is an abstraction over the various precisions of actual start time, and is not expected to be asserted directly. Values of predicates with different precisions can be compared since they are all formally xsd:datetimes." .

gists:Address a owl:Class ;
    rdfs:label "Address" ;
    rdfs:subClassOf gists:Content ;
    skos:altLabel "Address" ;
    skos:closeMatch <https://w3id.org/lmodel/common_domain_model/Address> ;
    skos:definition "A reference to a place (real or virtual) that can be located by some routing algorithm and where messages or things can be sent or received." ;
    skos:exactMatch gist:Address ;
    skos:inScheme gists:core .

gists:has_participant a owl:DatatypeProperty ;
    rdfs:label "has_participant" ;
    skos:altLabel "has participant" ;
    skos:definition "Relates something (e.g. an agreement) to things that play a role, or take part or are otherwise involved in some way." ;
    skos:inScheme gists:core ;
    skos:note "The thing with participants will often be an agreement, event or obligation. Participation does not imply agency.",
        "This will most often be used as an abstract property. Use subproperties that indicate the nature of the participation (e.g. hasBorrower, hasVenue)." .

gists:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:subClassOf gists:LivingThing ;
    skos:altLabel "Person" ;
    skos:broadMatch <https://w3id.org/lmodel/dpvs/DataSubject> ;
    skos:closeMatch <https://w3id.org/lmodel/common_domain_model/NaturalPerson>,
        <https://w3id.org/lmodel/iso22989/AIUser>,
        <https://w3id.org/lmodel/iso22989/DataSubject> ;
    skos:definition "A human being who was or is alive." ;
    skos:editorialNote "OWL equivalentClass: (gist:LivingThing & ∃hasBiologicalParent.gist:Person)",
        "OWL subClassOf restrictions: ∀hasBiologicalParent.gist:Person" ;
    skos:exactMatch <https://w3id.org/lmodel/dpvs/NaturalPerson>,
        gist:Person ;
    skos:inScheme gists:core ;
    skos:relatedMatch <https://w3id.org/lmodel/common_domain_model/Party> .

gists:PrefixDeclarationInstance a owl:Class ;
    rdfs:label "PrefixDeclarationInstance" ;
    owl:unionOf ( gist:_PrefixDeclaration_gist gist:_PrefixDeclaration_owl gist:_PrefixDeclaration_rdf gist:_PrefixDeclaration_rdfs gist:_PrefixDeclaration_sh gist:_PrefixDeclaration_skos gist:_PrefixDeclaration_xsd ) ;
    skos:definition "Named SHACL prefix declarations from the gist ontology." ;
    skos:inScheme gists:prefix-declarations ;
    linkml:permissible_values gist:_PrefixDeclaration_gist,
        gist:_PrefixDeclaration_owl,
        gist:_PrefixDeclaration_rdf,
        gist:_PrefixDeclaration_rdfs,
        gist:_PrefixDeclaration_sh,
        gist:_PrefixDeclaration_skos,
        gist:_PrefixDeclaration_xsd .

gists:AspectInstance a owl:Class ;
    rdfs:label "AspectInstance" ;
    owl:unionOf ( gistd:_Aspect_altitude gistd:_Aspect_area gistd:_Aspect_duration gistd:_Aspect_financial_balance gistd:_Aspect_mass gistd:_Aspect_monetary_value gistd:_Aspect_probability gistd:_Aspect_volume ) ;
    skos:definition "Named instances of gist:Aspect from gist reference data." ;
    skos:inScheme gists:core ;
    linkml:permissible_values gistd:_Aspect_altitude,
        gistd:_Aspect_area,
        gistd:_Aspect_duration,
        gistd:_Aspect_financial_balance,
        gistd:_Aspect_mass,
        gistd:_Aspect_monetary_value,
        gistd:_Aspect_probability,
        gistd:_Aspect_volume .

gists:Event a owl:Class ;
    rdfs:label "Event" ;
    rdfs:subClassOf gists:GistThing ;
    skos:altLabel "Event" ;
    skos:closeMatch <https://w3id.org/lmodel/common_domain_model/BusinessEvent>,
        <https://w3id.org/lmodel/iso22989/Action> ;
    skos:definition "Something that occurs over a period of time, often characterized as an activity being carried out by some person, organization, or software application or brought about by natural forces." ;
    skos:exactMatch gist:Event ;
    skos:inScheme gists:core ;
    skos:narrowMatch <https://w3id.org/lmodel/iso22989/AILifecycleProcess>,
        <https://w3id.org/lmodel/iso22989/DataProcess> ;
    skos:note "An event does not necessarily have either planned or actual start or end datetimes. For example, a conference can be in the planning phase without any dates selected, but is nevertheless an (unscheduled) event. The subclasses of gist:Event state particular restrictions on planned and actual start and end dates.",
        "An event occurs during a time interval, which is distinct from the event." .

gists:GeoLocation a owl:Class ;
    rdfs:label "GeoLocation" ;
    rdfs:subClassOf gists:GistThing ;
    skos:altLabel "Geographic Location" ;
    skos:closeMatch <https://w3id.org/lmodel/dpvs/StorageLocation> ;
    skos:definition "A physical location, with the earth as a frame of reference." ;
    skos:exactMatch gist:GeoLocation ;
    skos:inScheme gists:core ;
    skos:note "A geographic location may be a point, region, or volume." .

gists:Intention a owl:Class ;
    rdfs:label "Intention" ;
    rdfs:subClassOf gists:GistThing ;
    skos:altLabel "Intention" ;
    skos:definition "A goal, desire, or aspiration." ;
    skos:exactMatch gist:Intention ;
    skos:inScheme gists:core ;
    skos:note "The 'teleological' aspect of a system that indicates things are done with a purpose." .

gists:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:subClassOf gists:GistThing ;
    skos:altLabel "Organization" ;
    skos:broadMatch <https://w3id.org/lmodel/dpvs/OrganisationalUnit>,
        <https://w3id.org/lmodel/dpvs/ThirdParty> ;
    skos:closeMatch <https://w3id.org/lmodel/common_domain_model/BusinessUnit>,
        <https://w3id.org/lmodel/common_domain_model/LegalEntity>,
        <https://w3id.org/lmodel/common_domain_model/Party>,
        <https://w3id.org/lmodel/dpvs/LegalEntity> ;
    skos:definition "A structured entity formed to achieve specific goals, typically involving members with defined roles." ;
    skos:exactMatch <https://w3id.org/lmodel/iso22989/Organization>,
        gist:Organization ;
    skos:inScheme gists:core ;
    skos:note "Not all organizations have members, e.g. shell companies.",
        "While typically the members of organizations are people, in some cases they are other organizations; e.g., the members of the United Nations are country governments." .

gists:Category a owl:Class ;
    rdfs:label "Category" ;
    rdfs:subClassOf gists:GistThing ;
    skos:altLabel "Category" ;
    skos:definition "A concept or label used to categorize other instances without specifying any formal semantics." ;
    skos:editorialNote "OWL subClassOf restrictions: ∃isAllocatedBy.(gist:IntellectualProperty | gist:Organization | gist:Person)" ;
    skos:exactMatch gist:Category ;
    skos:inScheme gists:core ;
    skos:note "Often a type can be modeled either as an owl:Class or as a gist:Category. Use the latter if you don't care much about the formal structure of the different types, or if there is a whole hierarchy of types that are going to be managed by a group separate from the ontology developers. The formal structure may be defined elsewhere and linked to, if necessary." .

gists:MediaTypeInstance a owl:Class ;
    rdfs:label "MediaTypeInstance" ;
    owl:unionOf ( media_app:json <https://www.iana.org/assignments/media-types/application/ld+json> media_app:n-quads media_app:n-triples <https://www.iana.org/assignments/media-types/application/rdf+xml> <https://www.iana.org/assignments/media-types/application/sparql-results+json> <https://www.iana.org/assignments/media-types/application/sparql-results+xml> media_app:trig media_img:jpg media_img:png media_txt:csv media_txt:html media_txt:plain media_txt:turtle ) ;
    skos:definition "Named instances of gist:MediaType from gist reference data." ;
    skos:inScheme gists:media-types ;
    linkml:permissible_values media_app:json,
        <https://www.iana.org/assignments/media-types/application/ld+json>,
        media_app:n-quads,
        media_app:n-triples,
        <https://www.iana.org/assignments/media-types/application/rdf+xml>,
        <https://www.iana.org/assignments/media-types/application/sparql-results+json>,
        <https://www.iana.org/assignments/media-types/application/sparql-results+xml>,
        media_app:trig,
        media_img:jpg,
        media_img:png,
        media_txt:csv,
        media_txt:html,
        media_txt:plain,
        media_txt:turtle .

gists:UnitOfMeasure a owl:Class ;
    rdfs:label "UnitOfMeasure" ;
    rdfs:subClassOf gists:GistThing ;
    skos:altLabel "Unit of Measure" ;
    skos:closeMatch <https://w3id.org/lmodel/common_domain_model/UnitType> ;
    skos:definition "A standard amount used to measure or specify things." ;
    skos:exactMatch gist:UnitOfMeasure ;
    skos:inScheme gists:core .

gists:GistThing a owl:Class ;
    rdfs:label "GistThing" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gists:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gists:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gists:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gists:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty gists:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty gists:description ] ;
    skos:definition "Mixin providing universal slots applicable to any GIST entity. Covers OWL properties with no rdfs:domain (open-world)." ;
    skos:inScheme gists:core .

gists:UnitGroup a owl:Class ;
    rdfs:label "UnitGroup" ;
    rdfs:subClassOf gists:Collection ;
    skos:altLabel "Unit Group" ;
    skos:definition "A collection of units of measure that can all be used to measure the same aspects." ;
    skos:editorialNote "OWL subClassOf restrictions: ∃^isMemberOf.gist:UnitOfMeasure" ;
    skos:exactMatch gist:UnitGroup ;
    skos:inScheme gists:core ;
    skos:note "Typically there is one unit group per aspect. An example of an aspect with two unit groups is vehicle efficiency, which can be measured by miles per gallon (distance per volume) or by liters per 100 kilometers (volume per distance). These two units of measure need to be in different unit groups because they have different values of exponents. When adding a unit of measure to a unit group, make sure it has the same exponents as the other members of the unit group." .


